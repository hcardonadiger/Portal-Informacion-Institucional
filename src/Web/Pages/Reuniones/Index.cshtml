@page
@model Diger.TramitesEstado.Web.Pages.Reuniones.IndexModel
@inject AccesoModulosService Acceso
@functions {
    static string IC(string? inst)
    {
        if (string.IsNullOrEmpty(inst)) return "ic7";
        var h = 0; foreach (var c in inst) h = (h * 31 + c) & 0x7FFFFFFF;
        return $"ic{h % 8}";
    }
    static string InstIni(string? inst)
    {
        if (string.IsNullOrEmpty(inst)) return "—";
        return inst.Length >= 2 ? inst[..2].ToUpper() : inst.ToUpper();
    }
}
@{
    ViewData["Title"] = "Reuniones y Asistencias";
    var puedeGestionar = await Acceso.PuedeEditarAsync("Reuniones");
    var puedeEliminar  = await Acceso.PuedeEliminarAsync("Reuniones");

    // Una página con bloque @functions no resuelve `Context`, así que la ruta base se arma
    // con Url.Page y se captura; sirve además para el enlace de "Limpiar".
    var rutaBase = Url.Page("/Reuniones/Index");

    // Enlace de ordenamiento de un encabezado: conserva los filtros vigentes y vuelve a la
    // página 1, porque con otro orden el número de página anterior ya no significa lo mismo.
    Func<OrdenReuniones, string> OrdenUrl = col =>
    {
        var activa = Model.Orden == col;
        // Primer clic: ascendente, salvo fecha y creación, donde lo reciente arriba es lo útil.
        var desc = activa ? !Model.Desc : col is OrdenReuniones.Fecha or OrdenReuniones.Creacion;
        var parts = new List<string>();
        void Add(string k, string? v) { if (!string.IsNullOrEmpty(v)) parts.Add($"{k}={Uri.EscapeDataString(v)}"); }
        Add("q", Model.Q);
        Add("titulo", Model.FTitulo);
        Add("institucion", Model.FInstitucion);
        Add("tipo", Model.FTipo);
        Add("desde", Model.FDesde?.ToString("yyyy-MM-dd"));
        Add("hasta", Model.FHasta?.ToString("yyyy-MM-dd"));
        Add("creadaDesde", Model.FCreadaDesde?.ToString("yyyy-MM-dd"));
        Add("creadaHasta", Model.FCreadaHasta?.ToString("yyyy-MM-dd"));
        parts.Add("orden=" + col);
        parts.Add("desc=" + (desc ? "true" : "false"));
        return rutaBase + "?" + string.Join("&", parts);
    };
    Func<OrdenReuniones, string> Flecha = col => Model.Orden == col ? (Model.Desc ? " ▼" : " ▲") : "";
}

<div class="container" style="max-width:1040px">
    <partial name="_SuccessBanner" />
    <div class="hist-header">
        <div>
            <h2>Reuniones y Asistencias</h2>
            <p>Actas de reuniones y capacitaciones <span class="help-tip tip-down" data-tip="Gestione reuniones, registre asistencia con código QR, documente acuerdos y haga seguimiento a compromisos.">?</span></p>
        </div>
        <div style="display:flex;gap:8px">
            <button type="button" class="btns" id="btn-toggle-vista" onclick="toggleVistaReuniones()">Vista por institución</button>
            @if (puedeGestionar)
            {
                <a class="btnp" asp-page="/Reuniones/Editor">+ Nueva reunión</a>
            }
        </div>
    </div>

    <form method="get" class="lista-buscar">
        <input type="search" name="q" value="@Model.Q" placeholder="Buscar por título, institución o tipo…" />
        <button class="btns" type="submit">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Q)) { <a class="btns" asp-page="/Reuniones/Index">Limpiar</a> }
    </form>

    @* El vacío grande es sólo para "no hay nada registrado". Si el vacío viene de un filtro,
       hay que seguir mostrando la barra: si no, el usuario queda sin forma de deshacerlo. *@
    @if (Model.Resultado.Total == 0 && !Model.HayFiltros && string.IsNullOrEmpty(Model.Q))
    {
        <div class="hist-empty">
            <div class="ico"></div>
            <p>No hay reuniones registradas.</p>
        </div>
    }
    else
    {
        <div id="vista-lista">
            @* El filtro va al servidor: alcanza todas las reuniones, no sólo la página en pantalla. *@
            <form method="get" class="seg-filters" id="reunion-filters">
                @if (!string.IsNullOrEmpty(Model.Q)) { <input type="hidden" name="q" value="@Model.Q" /> }
                <input type="hidden" name="orden" value="@Model.Orden" />
                <input type="hidden" name="desc" value="@(Model.Desc ? "true" : "false")" />
                <div class="field" style="min-width:200px;flex:1">
                    <label for="f-titulo" style="font-size:11px;font-weight:700;color:#6b7fa3;text-transform:uppercase;letter-spacing:.06em">Título</label>
                    <input type="text" id="f-titulo" name="titulo" value="@Model.FTitulo" placeholder="Título de la reunión…" class="field-input" />
                </div>
                <div class="field" style="min-width:170px">
                    <label for="f-institucion" style="font-size:11px;font-weight:700;color:#6b7fa3;text-transform:uppercase;letter-spacing:.06em">Institución</label>
                    <select id="f-institucion" name="institucion" class="field-input">
                        <option value="">Todas</option>
                        @foreach (var i in Model.Opciones.Instituciones)
                        {
                            <option value="@i" selected="@(i == Model.FInstitucion)">@i</option>
                        }
                    </select>
                </div>
                <div class="field" style="min-width:150px">
                    <label for="f-tipo" style="font-size:11px;font-weight:700;color:#6b7fa3;text-transform:uppercase;letter-spacing:.06em">Tipo</label>
                    <select id="f-tipo" name="tipo" class="field-input">
                        <option value="">Todos</option>
                        @foreach (var t in Model.Opciones.Tipos)
                        {
                            <option value="@t" selected="@(t == Model.FTipo)">@t</option>
                        }
                    </select>
                </div>
                @* Desde y hasta comparten un solo campo: como dos rótulos sueltos, la barra
                   se partía en dos renglones. *@
                <div class="field" style="min-width:230px">
                    <label for="f-desde" style="font-size:11px;font-weight:700;color:#6b7fa3;text-transform:uppercase;letter-spacing:.06em">Fecha de reunión</label>
                    <div style="display:flex;align-items:center;gap:5px">
                        <input type="date" id="f-desde" name="desde" value="@Model.FDesde?.ToString("yyyy-MM-dd")" class="field-input" aria-label="Desde" style="min-width:0" />
                        <span style="color:#6b7fa3">–</span>
                        <input type="date" id="f-hasta" name="hasta" value="@Model.FHasta?.ToString("yyyy-MM-dd")" class="field-input" aria-label="Hasta" style="min-width:0" />
                    </div>
                </div>
                <div class="field" style="min-width:230px">
                    <label for="f-creada-desde" style="font-size:11px;font-weight:700;color:#6b7fa3;text-transform:uppercase;letter-spacing:.06em">Fecha de registro</label>
                    <div style="display:flex;align-items:center;gap:5px">
                        <input type="date" id="f-creada-desde" name="creadaDesde" value="@Model.FCreadaDesde?.ToString("yyyy-MM-dd")" class="field-input" aria-label="Registrada desde" style="min-width:0" />
                        <span style="color:#6b7fa3">–</span>
                        <input type="date" id="f-creada-hasta" name="creadaHasta" value="@Model.FCreadaHasta?.ToString("yyyy-MM-dd")" class="field-input" aria-label="Registrada hasta" style="min-width:0" />
                    </div>
                </div>
                <div class="field" style="align-self:flex-end;margin-bottom:0;display:flex;gap:6px">
                    <button type="submit" class="btnp">Filtrar</button>
                    @if (Model.HayFiltros)
                    {
                        <a class="btns" href="@rutaBase">✕ Limpiar</a>
                    }
                </div>
            </form>
            <table class="seg-table" id="reunion-tbl">
            <thead>
                <tr>
                    @* La flecha va como @(...) —expresión explícita—: escrita pegada al texto,
                       Razor lee "Título@Flecha" como una dirección de correo y la imprime literal. *@
                    <th><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Titulo)">Título@(Flecha(OrdenReuniones.Titulo))</a></th>
                    <th style="text-align:center"><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Fecha)">Fecha@(Flecha(OrdenReuniones.Fecha))</a></th>
                    <th style="text-align:center"><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Institucion)">Institución@(Flecha(OrdenReuniones.Institucion))</a></th>
                    <th style="text-align:center"><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Tipo)">Tipo@(Flecha(OrdenReuniones.Tipo))</a> <span class="help-tip tip-down tip-left" data-tip="Clasificación: reunión técnica, capacitación, taller, seguimiento, etc.">?</span></th>
                    <th style="text-align:center"><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Asistentes)">Asistentes@(Flecha(OrdenReuniones.Asistentes))</a></th>
                    <th style="text-align:center"><a class="th-orden" href="@OrdenUrl(OrdenReuniones.Creacion)" title="Fecha y hora en que se registró la reunión">Registro@(Flecha(OrdenReuniones.Creacion))</a></th>
                    <th style="width:1%"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Resultado.Items.Count == 0)
                {
                    <tr><td colspan="7" style="text-align:center;padding:2rem;color:#9aadcc">No se encontraron reuniones con los criterios aplicados.</td></tr>
                }
                @foreach (var r in Model.Resultado.Items)
                {
                    <tr>
                        <td>
                            <div class="reun-titulo-cell">
                                <span class="inst-av av-sm @IC(r.Institucion)" aria-hidden="true">@InstIni(r.Institucion)</span>
                                <div>
                                    <a class="seg-inst" asp-page="@(puedeGestionar ? "/Reuniones/Editor" : "/Reuniones/Acta")" asp-route-id="@r.Id">@r.Titulo</a>
                                    @if (r.HiloId is Guid h) { <a class="hilo-badge" asp-page="/Reuniones/Hilo" asp-route-id="@h" title="Pertenece a un hilo — ver hilo">🔗 hilo</a> }
                                </div>
                            </div>
                        </td>
                        <td class="res-meta" style="text-align:center">@(r.Fecha?.ToFechaCorta() ?? "—")</td>
                        <td style="text-align:center">
                            @if (r.Institucion != null) { <span class="inst-pill @IC(r.Institucion)">@r.Institucion</span> }
                            else { <span class="res-meta">—</span> }
                        </td>
                        <td class="res-meta" style="text-align:center">@(r.Tipo ?? "—")</td>
                        <td style="text-align:center">
                            @if (r.NumAsistentes > 0) { <span class="reun-asist-n">@r.NumAsistentes</span> }
                            else { <span class="res-meta">0</span> }
                        </td>
                        <td class="res-meta reun-registro" style="text-align:center" title="@r.CreadaEl.ToFechaHoraCorta()">@r.CreadaEl.ToFechaCorta()</td>
                        <td style="white-space:nowrap;text-align:right">
                            <a class="btns" asp-page="/Reuniones/Acta" asp-route-id="@r.Id"
                               style="font-size:12.5px;padding:6px 12px">Acta</a>
                            <a class="btns" asp-page="/Reuniones/Asistencia" asp-route-id="@r.Id"
                               style="font-size:12.5px;padding:6px 12px;margin-left:4px">Asistencia</a>
                            @if (puedeGestionar)
                            {
                                <a class="btns" asp-page="/Reuniones/Editor" asp-route-id="@r.Id"
                                   style="font-size:12.5px;padding:6px 12px;margin-left:4px">Editar</a>
                                <form method="post" asp-page-handler="Eliminar" style="display:inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="hist-del" type="submit" style="margin-left:4px"
                                            aria-label="Eliminar reunión" onclick="return confirm('¿Eliminar esta reunión?')">✕</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <partial name="_Paginacion" model="new PaginacionVm(Model.Resultado.Page, Model.Resultado.TotalPages, Model.Resultado.Total, Model.Resultado.Desde, Model.Resultado.Hasta)" />
        </div>

        @* ── Vista agrupada por institución ───────────────────────── *@
        <div id="vista-agrupada" style="display:none">
            @foreach (var grupo in Model.Todas.GroupBy(r => r.Institucion ?? "Sin institución").OrderBy(g => g.Key))
            {
                <div class="grupo-inst">
                    <div class="grupo-inst-hdr" onclick="toggleGrupoInst(this)">
                        <span class="inst-av av-lg @IC(grupo.Key == "Sin institución" ? null : grupo.Key)" aria-hidden="true">@InstIni(grupo.Key == "Sin institución" ? null : grupo.Key)</span>
                        <strong>@grupo.Key</strong>
                        <span class="grupo-inst-badge">@grupo.Count() reuni@(grupo.Count() == 1 ? "ón" : "ones")</span>
                        <span class="grupo-inst-chevron">▾</span>
                    </div>
                    <div class="grupo-inst-body">
                        <table class="seg-table">
                            <thead>
                                <tr>
                                    <th>Título</th>
                                    <th style="text-align:center">Fecha</th>
                                    <th style="text-align:center">Tipo</th>
                                    <th style="text-align:center">Asistentes</th>
                                    <th style="width:1%"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Sin reordenar: Model.Todas ya viene por última creación desde el handler,
                                   y GroupBy conserva ese orden dentro de cada institución. *@
                                @foreach (var r in grupo)
                                {
                                    <tr>
                                        <td><a class="seg-inst" asp-page="@(puedeGestionar ? "/Reuniones/Editor" : "/Reuniones/Acta")" asp-route-id="@r.Id">@r.Titulo</a>@if (r.HiloId is Guid h) { <a class="hilo-badge" asp-page="/Reuniones/Hilo" asp-route-id="@h" title="Pertenece a un hilo — ver hilo">🔗 hilo</a> }</td>
                                        <td class="res-meta" style="text-align:center">@(r.Fecha?.ToFechaCorta() ?? "—")</td>
                                        <td class="res-meta" style="text-align:center">@(r.Tipo ?? "—")</td>
                                        <td style="text-align:center">
                                            @if (r.NumAsistentes > 0) { <span class="reun-asist-n">@r.NumAsistentes</span> }
                                            else { <span class="res-meta">0</span> }
                                        </td>
                                        <td style="white-space:nowrap;text-align:right">
                                            <a class="btns" asp-page="/Reuniones/Acta" asp-route-id="@r.Id"
                                               style="font-size:12.5px;padding:6px 12px">Acta</a>
                                            <a class="btns" asp-page="/Reuniones/Asistencia" asp-route-id="@r.Id"
                                               style="font-size:12.5px;padding:6px 12px;margin-left:4px">Asistencia</a>
                                            @if (puedeGestionar)
                                            {
                                                <a class="btns" asp-page="/Reuniones/Editor" asp-route-id="@r.Id"
                                                   style="font-size:12.5px;padding:6px 12px;margin-left:4px">Editar</a>
                                                <form method="post" asp-page-handler="Eliminar" style="display:inline">
                                                    <input type="hidden" name="id" value="@r.Id" />
                                                    <button class="hist-del" type="submit" style="margin-left:4px"
                                                            aria-label="Eliminar reunión" onclick="return confirm('¿Eliminar esta reunión?')">✕</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>
<style>
    .reun-titulo-cell { display: flex; align-items: center; gap: 10px; }
    .reun-titulo-cell > div { display: flex; flex-direction: column; gap: 2px; }
    .reun-asist-n {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 26px; height: 22px; padding: 0 7px;
        background: var(--diger-blue-light); color: var(--diger-blue);
        border-radius: 20px; font-size: 12px; font-weight: 700;
    }
    .grupo-inst-hdr { display: flex; align-items: center; gap: 10px; }
    /* Encabezados ordenables: se leen como encabezado, no como enlace suelto. */
    .th-orden { color: inherit; text-decoration: none; white-space: nowrap; cursor: pointer; }
    .th-orden:hover { text-decoration: underline; }
    /* La píldora trae white-space: nowrap del CSS global; un nombre largo de institución
       estiraba la columna y con ella toda la tabla, sacando la página hacia la derecha.
       Acá se deja bajar de renglón. Sólo en este listado: la píldora se usa también en
       Asistencia, donde el ancho no molesta. */
    #reunion-tbl .inst-pill {
        white-space: normal;
        display: inline-block;
        max-width: 190px;
        line-height: 1.25;
        text-align: center;
    }
    #reunion-tbl .reun-registro { white-space: nowrap; }
</style>
<script>
    function toggleVistaReuniones() {
        var lista = document.getElementById('vista-lista');
        var agrupada = document.getElementById('vista-agrupada');
        var btn = document.getElementById('btn-toggle-vista');
        if (!lista || !agrupada) return;
        var enLista = agrupada.style.display === 'none';
        lista.style.display = enLista ? 'none' : '';
        agrupada.style.display = enLista ? '' : 'none';
        btn.textContent = enLista ? 'Vista de lista' : 'Vista por institución';
    }
    function toggleGrupoInst(hdr) {
        var body = hdr.nextElementSibling;
        var chevron = hdr.querySelector('.grupo-inst-chevron');
        var abierto = body.style.display !== 'none';
        body.style.display = abierto ? 'none' : '';
        chevron.style.transform = abierto ? 'rotate(-90deg)' : 'rotate(0deg)';
    }
</script>