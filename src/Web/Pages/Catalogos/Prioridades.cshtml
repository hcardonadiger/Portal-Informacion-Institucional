@page
@using Diger.TramitesEstado.Application.Dashboards.Queries
@model Diger.TramitesEstado.Web.Pages.Catalogos.PrioridadesModel
@{
    ViewData["Title"] = "Prioridades de proyectos";
}

<div class="container" style="max-width:960px">
    <partial name="_SuccessBanner" />
    @if (TempData["ErrorMsg"] is string terr)
    {
        <div class="alert-error" style="margin-bottom:1rem">@terr</div>
    }
    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert-error" style="margin-bottom:1rem">@Model.Error</div>
    }

    <div class="hist-header">
        <div>
            <h2>Prioridades de proyectos</h2>
            <p>Las opciones que ofrece la ficha de un proyecto. El <strong>orden</strong> decide cómo se listan y cuál pesa más al ordenar los tableros.</p>
        </div>
        <a class="btns" asp-page="/Catalogos/Index" style="font-size:13px">← Catálogos</a>
    </div>

    <div class="card">
        <h3 class="sec-h">Nueva prioridad</h3>
        <form method="post" asp-page-handler="Crear" style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end">
            <div class="field" style="margin:0;flex:1;min-width:180px">
                <label>Nombre <span style="color:#dc2626">*</span></label>
                <input name="Nombre" value="@Model.Nombre" placeholder="p. ej. Q3" maxlength="40" />
            </div>
            <div class="field" style="margin:0;width:110px">
                <label>Orden</label>
                <input type="number" name="Orden" min="0" max="999" placeholder="al final" />
            </div>
            <div class="field" style="margin:0;width:150px">
                <label>Color</label>
                <select name="Color">
                    @foreach (var c in Enum.GetValues<ColorEtiqueta>())
                    {
                        <option value="@((int)c)" selected="@(c == Model.Color)">@c</option>
                    }
                </select>
            </div>
            <button class="btnp" type="submit" style="margin-bottom:.1rem">Agregar prioridad</button>
        </form>
    </div>

    <div class="card">
        <h3 class="sec-h">Catálogo</h3>
        @if (Model.Prioridades.Count == 0)
        {
            <p class="res-meta">Aún no hay prioridades. Cree al menos una: sin ninguna activa no se pueden crear proyectos.</p>
        }
        else
        {
            @* Mismo par de clases que el catálogo de temas: .edit-grid es la que estila los
               controles dentro de una tabla editable. *@
            <table class="seg-table edit-grid">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th style="width:84px">Orden</th>
                        <th style="width:120px">Color</th>
                        <th style="width:80px">Activa</th>
                        <th style="width:92px">Proyectos</th>
                        <th style="width:130px">Predeterminada</th>
                        <th style="width:112px"></th>
                        <th style="width:56px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Prioridades)
                    {
                        <tr>
                            @* El <form> como hijo directo de <tr> no envuelve nada —el parser lo
                               saca de la pila— pero los controles quedan asociados a él. Es el
                               mismo recurso que usa /Tickets/Temas. *@
                            <form method="post" asp-page-handler="Actualizar">
                                <input type="hidden" name="id" value="@p.Id" />
                                <td>
                                    <input name="nombre" value="@p.Nombre" maxlength="40" style="width:100%" />
                                </td>
                                <td><input type="number" name="orden" value="@p.Orden" min="0" max="999" style="width:100%" /></td>
                                <td>
                                    <select name="color">
                                        @foreach (var c in Enum.GetValues<ColorEtiqueta>())
                                        {
                                            <option value="@((int)c)" selected="@(c == p.Color)">@c</option>
                                        }
                                    </select>
                                </td>
                                <td style="text-align:center"><input type="checkbox" name="activo" value="true" checked="@p.Activo" /></td>
                                <td class="res-meta" style="text-align:center">@p.Proyectos</td>
                                <td style="text-align:center">
                                    <span class="@Etiquetas.ClaseColor(p.Color)" style="padding:1px 8px;font-size:var(--diger-fs-2xs)">@p.Nombre</span>
                                </td>
                                <td style="text-align:right">
                                    <button class="btns" type="submit" style="font-size:12.5px;padding:6px 12px">Guardar</button>
                                </td>
                            </form>
                            <td style="text-align:right;white-space:nowrap">
                                @if (!p.EsPredeterminada)
                                {
                                    <form method="post" asp-page-handler="Predeterminada" style="display:inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="btns" type="submit" style="font-size:12.5px;padding:6px 10px"
                                                title="Usar «@p.Nombre» como prioridad inicial de los proyectos nuevos">☆</button>
                                    </form>
                                    <form method="post" asp-page-handler="Eliminar" style="display:inline">
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button class="hist-del" type="submit" aria-label="Eliminar prioridad"
                                                data-confirm="¿Eliminar la prioridad «@p.Nombre»?">✕</button>
                                    </form>
                                }
                                else
                                {
                                    <span title="Es la prioridad predeterminada: no se puede eliminar ni desactivar">★</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="res-meta" style="margin-top:.75rem">
                ★ marca la prioridad que traen los proyectos nuevos. Una prioridad con proyectos
                asignados no se puede eliminar —desactívela y dejará de ofrecerse, sin cambiarle
                nada a los proyectos que ya la tienen—.
            </p>
        }
    </div>
</div>
