@page
@using Diger.TramitesEstado.Web.Pages.Accesos
@model DiagnosticoModel
@{
    ViewData["Title"] = "Diagnóstico de acceso";
    var concedidas = Model.ClavesDeTodosLosRoles;
}

<div class="container" style="max-width:1000px">
    <div class="hist-header">
        <div>
            <h2>Diagnóstico de acceso</h2>
            <p>De dónde sale lo que un usuario puede y lo que no: su rol en cada asignación, el alcance de datos que ese rol otorga y las claves que la matriz le concede hoy.</p>
        </div>
    </div>
    <p class="hint">
        <a asp-page="./Permisos">← Administrar permisos</a>
        &nbsp;·&nbsp;
        <a asp-page="./Auditoria">Bitácora de cambios →</a>
    </p>

    <form method="get" class="card">
        <div class="field" style="margin:0">
            <label>Buscar usuario</label>
            <div style="display:flex;gap:8px">
                <input type="text" name="q" value="@Model.Q" placeholder="Nombre o correo" style="flex:1" />
                <button class="btns" type="submit">Buscar</button>
            </div>
        </div>
    </form>

    @if (Model.Usuarios.Total > 0)
    {
        <table class="seg-table" style="margin-bottom:1.25rem">
            <thead><tr><th>Usuario</th><th style="width:220px">Correo</th><th style="width:110px">Estado</th><th style="width:120px"></th></tr></thead>
            <tbody>
                @foreach (var u in Model.Usuarios.Items)
                {
                    <tr>
                        <td>@u.Nombre</td>
                        <td class="res-meta">@u.Correo</td>
                        <td>
                            @if (u.Activo)
                            {
                                <span class="wf-badge wf-activa">Activo</span>
                            }
                            else
                            {
                                <span class="wf-badge" style="background:var(--diger-danger-bg);color:var(--diger-danger-strong)">Inactivo</span>
                            }
                        </td>
                        <td style="text-align:right">
                            <a class="btns" style="font-size:12.5px;padding:6px 12px"
                               asp-page="./Diagnostico" asp-route-q="@Model.Q" asp-route-usuarioId="@u.Id">Diagnosticar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (Model.Diagnostico is { } d)
    {
        <div class="card">
            <div class="stitle">@d.Nombre · @d.Correo</div>

            @if (!d.Activo)
            {
                <div class="alert-error" style="margin-bottom:1rem">
                    El usuario está <strong>inactivo</strong>: no puede iniciar sesión, sin importar sus permisos.
                </div>
            }

            @if (d.Asignaciones.Count == 0)
            {
                <div class="alert-error" style="margin-bottom:1rem">
                    No tiene <strong>ninguna asignación</strong>. Sin institución, área o unidad asignada no tiene rol ni alcance de datos.
                </div>
            }

            <h3 class="sec-h">Asignaciones</h3>
            <table class="seg-table" style="margin-bottom:1.5rem">
                <thead><tr><th style="width:160px">Institución</th><th style="width:160px">Área</th><th style="width:160px">Unidad</th><th>Rol</th></tr></thead>
                <tbody>
                    @foreach (var a in d.Asignaciones)
                    {
                        <tr>
                            <td>@a.InstitucionId</td>
                            <td class="res-meta">@(a.AreaId ?? "—")</td>
                            <td class="res-meta">@(a.UnidadId ?? "—")</td>
                            <td>@a.RolId</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h3 class="sec-h">Roles y capacidades</h3>
            @foreach (var r in d.Roles)
            {
                <div style="border:1px solid var(--diger-border);border-radius:var(--diger-radius-sm);padding:.8rem 1rem;margin-bottom:.8rem">
                    <div style="display:flex;gap:10px;align-items:baseline;flex-wrap:wrap">
                        <strong>@r.Nombre</strong>
                        <span class="hint">@r.RolId</span>
                        @if (!r.ExisteEnCatalogo)
                        {
                            <span class="wf-badge" style="background:var(--diger-danger-bg);color:var(--diger-danger-strong)">Rol inexistente o inactivo</span>
                        }
                    </div>

                    @if (r.ExisteEnCatalogo)
                    {
                        <div class="hint" style="margin-top:6px">
                            Alcance de datos: <strong>@r.NivelAlcance</strong> ·
                            @r.Claves.Count clave(s) concedida(s)
                        </div>
                        <div style="margin-top:8px;display:flex;gap:6px;flex-wrap:wrap">
                            @if (r.EsAdministrador)  { <span class="wf-badge">Administrador</span> }
                            @if (r.EsSoloLectura)    { <span class="wf-badge">Solo lectura</span> }
                            @if (r.EsSupervisor)     { <span class="wf-badge">Supervisor</span> }
                            @if (r.EsTecnicoSoporte) { <span class="wf-badge">Soporte</span> }
                        </div>
                    }
                    else
                    {
                        <div class="hint" style="margin-top:6px">
                            El rol asignado no está en el catálogo activo, así que el usuario queda sin capacidades y con el alcance más restrictivo.
                        </div>
                    }
                </div>
            }

            <h3 class="sec-h" style="margin-top:1.5rem">Claves efectivas</h3>

            @if (Model.AlgunRolEsAdministrador)
            {
                <p class="hint" style="margin-bottom:1rem">
                    Tiene un rol con capacidad de administrador: aprueba <strong>todas</strong> las claves por código, sin depender de la matriz.
                </p>
            }

            <div style="overflow-x:auto">
                <table class="seg-table">
                    <thead><tr><th>Permiso</th><th style="width:90px;text-align:center">Tiene</th></tr></thead>
                    <tbody>
                        @foreach (var (area, permisos) in Model.PorArea)
                        {
                            <tr><td colspan="2" style="background:var(--diger-bg-soft)"><strong>@area</strong></td></tr>
                            @foreach (var p in permisos)
                            {
                                var tiene = Model.AlgunRolEsAdministrador || concedidas.Contains(p.Clave);
                                <tr>
                                    <td>
                                        @CatalogoModulos.Obtener(p.Modulo).Etiqueta — @p.Accion
                                        <div class="hint">@p.Clave</div>
                                    </td>
                                    <td style="text-align:center;color:@(tiene ? "var(--diger-success-strong)" : "var(--diger-text-muted)")">
                                        @(tiene ? "✓" : "·")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
