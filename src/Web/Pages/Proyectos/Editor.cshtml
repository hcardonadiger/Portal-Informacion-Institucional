        </div>
    }
</div>

@* Las secciones no pueden declararse dentro de un bloque condicional: se define siempre y el
   script solo hace algo si la tabla editable está en la página. *@
@section Scripts {
<script>
    (function () {
        var tabla = document.querySelector('#tabla-hitos tbody');
        if (!tabla) return;

        // El índice arranca donde terminó el render del servidor y solo crece: como cada fila
        // lleva su propio Hitos.Index, borrar en el medio no obliga a renumerar nada.
        var hitoIdx = @p.Hitos.Count;
        var reordenable = @(Model.PuedeReordenar ? "true" : "false");
        var usuariosOpts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Usuarios.Select(u => new { id = u.Id, nombre = u.Nombre })));
        var estados = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Enum.GetValues<EstadoHito>().Select(e => new { v = (int)e, t = e.ToString() })));

        function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;'); }

        window.agregarHito = function () {
            var i = hitoIdx++;
            var opts = '<option value="">—</option>' +
                usuariosOpts.map(function (u) {
                    return '<option value="' + esc(u.id) + '">' + esc(u.nombre) + '</option>';
                }).join('');
            var estadoOpts = estados.map(function (e) {
                return '<option value="' + e.v + '">' + esc(e.t) + '</option>';
            }).join('');

            var tr = document.createElement('tr');
            tr.innerHTML =
                '<input type="hidden" name="Hitos.Index" value="' + i + '" />' +
                // Id 0 = fila nueva: el comando la inserta al final en vez de actualizar.
                '<input type="hidden" name="Hitos[' + i + '].Id" value="0" />' +
                '<input type="hidden" name="Hitos[' + i + '].Descripcion" value="" />' +
                '<td><input name="Hitos[' + i + '].Nombre" maxlength="300" style="width:100%" placeholder="Nombre del hito" /></td>' +
                '<td><select name="Hitos[' + i + '].ResponsableId">' + opts + '</select></td>' +
                '<td><input type="date" name="Hitos[' + i + '].FechaPlan" /></td>' +
                '<td><input type="date" name="Hitos[' + i + '].FechaReal" /></td>' +
                '<td><select name="Hitos[' + i + '].Estado">' + estadoOpts + '</select></td>' +
                // La columna de orden solo existe si el usuario puede reordenar; el hito nuevo
                // todavía no tiene Id, así que va vacía y no participa del reordenamiento hasta
                // que se guarde la ficha.
                (reordenable ? '<td></td>' : '') +
                '<td style="text-align:right"><button type="button" class="hist-del" aria-label="Quitar hito" onclick="quitarHito(this)">&#10005;</button></td>';
            tabla.appendChild(tr);
            tr.querySelector('input[name$=".Nombre"]').focus();
        };

        window.quitarHito = function (btn) {
            btn.closest('tr').remove();
        };

        // ── Reordenar ────────────────────────────────────────────────────
        // Solo mueve la fila en el DOM. El input OrdenHitos viaja dentro de ella, así que el
        // orden que se postea a «Guardar orden» es exactamente el que quedó en pantalla.
        window.moverHito = function (btn, dir) {
            var fila = btn.closest('tr');
            var destino = dir < 0 ? fila.previousElementSibling : fila.nextElementSibling;
            if (!destino) return;

            if (dir < 0) tabla.insertBefore(fila, destino);
            else         tabla.insertBefore(destino, fila);

            var aviso = document.getElementById('aviso-orden');
            if (aviso) aviso.hidden = false;

            // El foco se queda en el botón que se usó, que ahora está en otra posición.
            var mismo = fila.querySelector(dir < 0 ? '.hito-mov' : '.hito-mov + .hito-mov');
            if (mismo) mismo.focus();
        };
    })();

    // Encadena unidad con área: solo se ofrecen las unidades del área elegida, y al cambiar de
    // área se limpia la unidad para no dejar una combinación imposible.
    (function () {
        var area = document.getElementById('f-area');
        var unidad = document.getElementById('f-unidad');
        if (!area || !unidad) return;

        function filtrar() {
            var sel = area.value;
            var hayQueLimpiar = false;
            Array.prototype.forEach.call(unidad.options, function (o) {
                if (!o.value) return;                       // la opción vacía siempre se ve
                var visible = !sel || o.dataset.area === sel;
                o.hidden = !visible;
                if (!visible && o.selected) hayQueLimpiar = true;
            });
            if (hayQueLimpiar) unidad.value = '';
        }

        area.addEventListener('change', filtrar);
        filtrar();
    })();

    // Fuera del bloque anterior: la bitácora existe aunque no haya tabla de hitos editable.
    window.alternarCorreccion = function (id) {
        var f = document.getElementById('correccion-' + id);
        if (!f) return;
        f.hidden = !f.hidden;
        if (!f.hidden) f.querySelector('textarea').focus();
    };

    // «Dar el hito por cumplido» solo tiene sentido con un hito elegido que siga abierto.
    // Al ocultarlo se destilda, para que no viaje marcado desde una selección anterior.
    window.alternarCompletarHito = function () {
        var sel = document.getElementById('a-hito');
        var lbl = document.getElementById('a-cerrar-hito');
        if (!sel || !lbl) return;

        var op = sel.options[sel.selectedIndex];
        var aplica = !!sel.value && op && op.getAttribute('data-cerrado') === '0';

        lbl.hidden = !aplica;
        if (!aplica) document.getElementById('a-cerrar').checked = false;
    };
    alternarCompletarHito();
</script>
}
