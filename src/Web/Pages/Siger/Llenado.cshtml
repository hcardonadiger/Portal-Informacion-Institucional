@page
@using Diger.TramitesEstado.Domain.Enums
@model Diger.TramitesEstado.Web.Pages.Siger.LlenadoModel
@inject AccesoModulosService Acceso
@{
    ViewData["Title"] = "Llenado asistido";
    var puedeDecidir = await Acceso.PuedeClaveAsync("Siger.Llenado.Editar");
    var enPendientes = Model.Tab == "pendientes";
}

<div class="container">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:1rem;flex-wrap:wrap">
        <a class="btns" asp-page="/Siger/Index" style="font-size:13px">← Inventario</a>
        <h2 style="margin:0;font-size:18px;color:#0a2d6e">Llenado asistido</h2>
    </div>

    <div class="card" style="margin-bottom:1rem">
        <p style="font-size:14px;line-height:1.55;color:#4a5568;margin:0 0 .6rem">
            El sistema propone valores para los campos vacíos de las fichas; <strong>nada se
            escribe sin que alguien lo apruebe acá</strong>. Cada propuesta dice de dónde salió y
            con cuánta certeza, para que se pueda aceptar en bloque sin firmar a ciegas.
        </p>
        <p style="font-size:14px;line-height:1.55;color:#4a5568;margin:0">
            Hay <strong>@Model.Pendientes</strong> propuestas esperando decisión y
            <strong>@Model.HuecosSinPropuesta</strong> huecos que ninguna regla supo llenar
            —esos necesitan a una persona—.
        </p>

        @if (puedeDecidir)
        {
            <form method="post" style="margin-top:.8rem">
                <button class="btns" type="submit" asp-page-handler="Generar">Generar propuestas</button>
                <span class="res-meta">Se puede correr las veces que haga falta: no duplica ni insiste con lo ya rechazado.</span>
            </form>
        }
    </div>

    @* ── Pestañas ──────────────────────────────────────────────── *@
    <div style="display:flex;gap:6px;border-bottom:2px solid #e2e8f0;margin-bottom:1rem;flex-wrap:wrap">
        @{
            var tabs = new (string Key, string Label, int Count)[]
            {
                ("pendientes", "Por revisar", Model.Pendientes),
                ("aprobadas",  "Aprobadas",   Model.Aprobadas),
                ("rechazadas", "Rechazadas",  Model.Rechazadas)
            };
        }
        @foreach (var t in tabs)
        {
            var activa = Model.Tab == t.Key;
            <a asp-page="/Siger/Llenado" asp-route-tab="@t.Key" asp-route-sigla="@Model.Sigla"
               asp-route-campo="@Model.Campo" asp-route-certeza="@Model.Certeza" asp-route-buscar="@Model.Buscar"
               style="padding:8px 16px;text-decoration:none;font-weight:600;font-size:14px;border-bottom:3px solid @(activa ? "#1455a4" : "transparent");color:@(activa ? "#1455a4" : "#64748b")">
                @t.Label <span style="opacity:.7">(@t.Count)</span>
            </a>
        }
    </div>

    @* ── Filtros ───────────────────────────────────────────────── *@
    <form method="get" class="seg-filters">
        <input type="hidden" name="tab" value="@Model.Tab" />
        <div class="field">
            <label>Buscar</label>
            <input name="buscar" value="@Model.Buscar" placeholder="Nombre, código o institución..." />
        </div>
        <div class="field" style="min-width:150px">
            <label>Institución</label>
            <select name="sigla">
                <option value="">Todas</option>
                @foreach (var s in Model.Siglas)
                {
                    <option value="@s" selected="@(Model.Sigla == s)">@s</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:130px">
            <label>Campo</label>
            <select name="campo">
                <option value="">Todos</option>
                @foreach (var c in Enum.GetNames<CampoFicha>())
                {
                    <option value="@c" selected="@(Model.Campo == c)">@c</option>
                }
            </select>
        </div>
        <div class="field" style="min-width:120px">
            <label>Certeza</label>
            <select name="certeza">
                <option value="">Todas</option>
                @foreach (var c in Enum.GetNames<CertezaLlenado>())
                {
                    <option value="@c" selected="@(Model.Certeza == c)">@c</option>
                }
            </select>
        </div>
        <button class="btnp" type="submit">Filtrar</button>
        <a class="btns" asp-page="/Siger/Llenado" asp-route-tab="@Model.Tab">Limpiar</a>
    </form>

    @if (!Model.Resultado.Items.Any())
    {
        <div class="card">
            <p style="font-size:14px;color:#64748b;margin:0">
                @(enPendientes
                    ? "No hay propuestas pendientes con este filtro. Si la cola está vacía del todo, corra «Generar propuestas»."
                    : "No hay propuestas con este filtro.")
            </p>
        </div>
    }
    else
    {
        <form method="post">
            <input type="hidden" name="tab" value="@Model.Tab" />
            <input type="hidden" name="sigla" value="@Model.Sigla" />
            <input type="hidden" name="campo" value="@Model.Campo" />
            <input type="hidden" name="certeza" value="@Model.Certeza" />
            <input type="hidden" name="buscar" value="@Model.Buscar" />
            <input type="hidden" name="pg" value="@Model.Resultado.Page" />

            @if (puedeDecidir && enPendientes)
            {
                <div style="display:flex;gap:8px;align-items:center;margin-bottom:.6rem;flex-wrap:wrap">
                    <button class="btnp" type="submit" asp-page-handler="Aprobar">Aprobar marcadas</button>
                    <button class="btns" type="submit" asp-page-handler="Rechazar">Rechazar marcadas</button>

                    <button class="btns" type="submit" asp-page-handler="AprobarFiltro"
                            style="border-color:#b45309;color:#b45309"
                            onclick="return confirm('Se van a escribir @Model.AlcanceDelFiltro valor(es) en sus fichas, no solo los marcados en esta página. ¿Continuar?')">
                        Aprobar las @Model.AlcanceDelFiltro que coinciden con el filtro
                    </button>
                </div>
                <p class="res-meta" style="margin:0 0 .8rem">
                    Aprobar escribe el valor en la ficha solo si el campo sigue vacío: lo que alguien
                    haya llenado a mano no se pisa nunca.
                </p>
            }

            <div style="overflow-x:auto">
                <table class="seg-table">
                    <thead>
                        <tr>
                            @if (puedeDecidir && enPendientes)
                            {
                                <th style="width:34px"><input type="checkbox" onclick="document.querySelectorAll('.chk-prop').forEach(c=>c.checked=this.checked)" /></th>
                            }
                            <th>Código</th>
                            <th>Trámite</th>
                            <th>Inst.</th>
                            <th>Campo</th>
                            <th>Valor propuesto</th>
                            <th>Certeza</th>
                            <th>De dónde sale</th>
                            @if (!enPendientes)
                            {
                                <th>Decidió</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.Resultado.Items)
                        {
                            <tr>
                                @if (puedeDecidir && enPendientes)
                                {
                                    <td><input class="chk-prop" type="checkbox" name="Seleccion" value="@f.Id" /></td>
                                }
                                <td style="white-space:nowrap">@f.Codigo</td>
                                <td>@f.Nombre</td>
                                <td style="white-space:nowrap">@f.Institucion</td>
                                <td style="white-space:nowrap">@f.Campo</td>
                                <td><strong>@f.Valor</strong></td>
                                <td style="white-space:nowrap">
                                    <span style="font-size:11px;font-weight:700;background:@f.FondoCerteza;color:@f.ColorCerteza;padding:2px 8px;border-radius:4px">@f.Certeza</span>
                                </td>
                                <td style="font-size:12px;color:#4a5568;max-width:380px">@f.Justificacion</td>
                                @if (!enPendientes)
                                {
                                    <td style="white-space:nowrap;font-size:12px;color:#64748b">
                                        @(f.DecididaPor ?? "—")<br />
                                        <span style="opacity:.75">@(f.DecididaEl?.ToString("dd/MM/yyyy HH:mm") ?? "")</span>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>

        <partial name="_Paginacion" model="new PaginacionVm(Model.Resultado.Page, Model.Resultado.TotalPages, Model.Resultado.Total, Model.Resultado.Desde, Model.Resultado.Hasta)" />
    }

    <div class="card" style="margin-top:1rem">
        <h3 class="sec-h">Qué significa la certeza</h3>
        <p style="font-size:14px;line-height:1.55;color:#4a5568;margin:0 0 .5rem">
            <strong style="color:#0f5132">Alta</strong> — el dato ya estaba en la base y solo hubo
            que transformarlo; por ejemplo, el tiempo sale de sumar los días declarados en cada
            paso. Quien revise llegaría al mismo valor. Es lo que se puede aprobar en bloque con
            menos riesgo.
        </p>
        <p style="font-size:14px;line-height:1.55;color:#4a5568;margin:0 0 .5rem">
            <strong style="color:#b45309">Media</strong> — sale de una señal fuerte pero indirecta:
            el texto del trámite menciona un pago, o el nombre contiene una palabra que delata su
            tema. Suele acertar; conviene mirar una muestra antes de aceptar el resto.
        </p>
        <p style="font-size:14px;line-height:1.55;color:#4a5568;margin:0">
            <strong style="color:#9f1239">Baja</strong> — es un supuesto razonable, no una
            derivación. La modalidad, por ejemplo: hoy ninguna ficha registra si el trámite se hace
            en línea, así que «Presencial» se propone por descarte. Se propone porque un valor por
            defecto correcto sirve más que el vacío, pero merece que alguien lo mire.
        </p>
    </div>
</div>
