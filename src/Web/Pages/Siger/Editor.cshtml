@page
@model Diger.TramitesEstado.Web.Pages.Siger.EditorModel
@{
    ViewData["Title"] = Model.EsNuevo ? "Nuevo Tramite SIGER" : "Editar Tramite SIGER";
}

<div class="container" style="max-width:860px">
    <div class="hist-header">
        <div>
            <h2>@ViewData["Title"]</h2>
            <p>@(Model.EsNuevo ? "Registrar un nuevo tramite en el inventario" : "Modificar datos del tramite")</p>
        </div>
        <a class="btns" asp-page="/Siger/Index">Cancelar</a>
    </div>

    @* ── Qué le falta a esta ficha ───────────────────────────────── *@
    @if (!Model.EsNuevo && Model.Faltantes.Count > 0)
    {
        <div class="card" role="alert"
             style="margin-bottom:1rem;border-left:4px solid #b45309;background:#fffbeb">
            <strong style="color:#b45309">@FichaPublicaCompletitud.Frase(Model.Faltantes)</strong>
            <p style="margin:6px 0 0">
                Mientras falte cualquiera de esos datos, el trámite no se publica en el Portal de
                Trámites y Servicios, aunque esté aprobado.
            </p>
        </div>
    }
    else if (!Model.EsNuevo)
    {
        <div class="card"
             style="margin-bottom:1rem;border-left:4px solid #15803d;background:#f0fdf4">
            <strong style="color:#15803d">La ficha pública está completa.</strong>
            <span>Se publica en cuanto el trámite quede en estado Aprobado o Completo.</span>
        </div>
    }

    <form method="post" class="card">
        <input type="hidden" asp-for="Form.Id" />

        <div class="form-grid">
            <div class="field">
                <label asp-for="Form.IdSiger">Id SIGER</label>
                <input asp-for="Form.IdSiger" type="number" required />
            </div>
            <div class="field">
                <label asp-for="Form.Codigo">Codigo</label>
                <input asp-for="Form.Codigo" required maxlength="20" placeholder="400-001" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Form.Nombre">Nombre del tramite</label>
            <input asp-for="Form.Nombre" required maxlength="600" />
        </div>

        <div class="form-grid">
            <div class="field">
                <label asp-for="Form.Institucion">Institucion</label>
                <input asp-for="Form.Institucion" required maxlength="200" />
            </div>
            <div class="field">
                <label asp-for="Form.Sigla">Sigla</label>
                <input asp-for="Form.Sigla" maxlength="30" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Form.Dependencia">Dependencia o area responsable</label>
            <input asp-for="Form.Dependencia" maxlength="400" />
        </div>

        <div class="field">
            <label asp-for="Form.Descripcion">Descripcion</label>
            <textarea asp-for="Form.Descripcion" rows="3"></textarea>
        </div>

        <div class="field">
            <label asp-for="Form.Objetivo">Objetivo</label>
            <textarea asp-for="Form.Objetivo" rows="2"></textarea>
        </div>

        <div class="field">
            <label asp-for="Form.DirigidoA">Dirigido a</label>
            <textarea asp-for="Form.DirigidoA" rows="2"></textarea>
        </div>

        <div class="form-grid" style="grid-template-columns:1fr 1fr 1fr">
            <div class="field">
                <label asp-for="Form.EstadoSiger">Estado en SIGER</label>
                <select asp-for="Form.EstadoSiger">
                    <option value="">— Seleccione —</option>
                    <option value="Registrado">Registrado</option>
                    <option value="Aprobado">Aprobado</option>
                    <option value="Completo">Completo</option>
                    <option value="Borrador">Borrador</option>
                </select>
            </div>
            <div class="field">
                <label asp-for="Form.VigenciaDocumento">Vigencia del documento</label>
                <input asp-for="Form.VigenciaDocumento" maxlength="60" />
            </div>
            <div class="field">
                <label asp-for="Form.Temporalidad">Temporalidad</label>
                <input asp-for="Form.Temporalidad" maxlength="60" />
            </div>
        </div>

        <div class="form-grid" style="grid-template-columns:1fr 1fr">
            <div class="field">
                <label class="chk-label">
                    <input asp-for="Form.DisponibleEnLinea" type="checkbox" /> Disponible en linea (legado, sin usar)
                </label>
            </div>
            <div class="field">
                <label class="chk-label">
                    <input asp-for="Form.EnPlanDigitalizacion" type="checkbox" /> En plan de digitalizacion
                </label>
            </div>
        </div>

        <div class="field" style="background:var(--diger-blue-pale, #eef3fb);padding:12px 16px;border-radius:8px;margin-bottom:1rem">
            <strong>Publicado en el portal ciudadano:</strong>
            @if (Model.PublicadoActual)
            {
                <span class="wf-badge wf-completada">Sí</span>
            }
            else
            {
                <span class="wf-badge wf-registrada">No</span>
                <span class="res-meta">— se publica solo cuando el estado es Aprobado/Completo y la ficha está completa (categoría, modalidad, tiempo, costo, y enlace a SOL si aplica)</span>
            }
            @if (!Model.EsNuevo)
            {
                <div class="res-meta" style="margin-top:4px">
                    Última revisión: @(Model.UltimaRevision?.ToString("dd/MM/yyyy") ?? "—")
                </div>
            }
        </div>

        <h3 style="margin-top:1.5rem">Ficha pública (Ventanilla Digital)</h3>
        <div class="form-grid" style="grid-template-columns:1fr 1fr">
            <div class="field">
                <label asp-for="Form.CategoriaId">Categoría</label>
                <select asp-for="Form.CategoriaId">
                    <option value="">— Sin categoría —</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.Id">@c.Nombre</option>
                    }
                </select>
            </div>
            <div class="field">
                <label asp-for="Form.Modalidad">Modalidad</label>
                <select asp-for="Form.Modalidad">
                    <option value="">— Sin definir —</option>
                    <option value="Virtual">Virtual</option>
                    <option value="Presencial">Presencial</option>
                    <option value="Hibrido">Híbrido</option>
                </select>
            </div>
        </div>

        <div class="form-grid" style="grid-template-columns:1fr 1fr">
            <div class="field">
                <label asp-for="Form.TiempoTexto">Tiempo estimado (texto libre)</label>
                <input asp-for="Form.TiempoTexto" maxlength="120" placeholder="ej. 5 días hábiles" />
            </div>
            <div class="field">
                <label asp-for="Form.CostoTexto">Costo (texto libre)</label>
                <input asp-for="Form.CostoTexto" maxlength="250" placeholder="ej. L. 200.00, o Gratuito" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Form.CostoEsGratuito">¿Es gratuito?</label>
            <select asp-for="Form.CostoEsGratuito">
                <option value="">— No especificado —</option>
                <option value="true">Sí, es gratuito</option>
                <option value="false">No, tiene costo</option>
            </select>
        </div>

        <div class="field">
            <label class="chk-label">
                <input asp-for="Form.EstaEnSol" type="checkbox" id="chk-en-sol" /> Se puede hacer desde SOL
            </label>
        </div>
        <div class="field">
            <label asp-for="Form.SolUrl">Enlace a SOL (URL completa)</label>
            <input asp-for="Form.SolUrl" type="url" maxlength="500" placeholder="https://sol.pdihonduras.gob.hn/..." />
            <span asp-validation-for="Form.SolUrl" class="field-error"></span>
        </div>

        <div class="field">
            <label class="chk-label">
                <input asp-for="Form.EsPopular" type="checkbox" /> Marcar como trámite popular
            </label>
        </div>

        <h3 style="margin-top:1.5rem">Otros datos</h3>
        <div class="form-grid">
            <div class="field">
                <label asp-for="Form.EnlacePrincipal">Enlace principal</label>
                <input asp-for="Form.EnlacePrincipal" type="url" maxlength="600" />
            </div>
            <div class="field">
                <label asp-for="Form.DiagramaUrl">URL del diagrama</label>
                <input asp-for="Form.DiagramaUrl" maxlength="600" />
            </div>
        </div>

        <div class="field">
            <label asp-for="Form.FechaIngreso">Fecha de ingreso</label>
            <input asp-for="Form.FechaIngreso" type="date" />
        </div>

        <div class="field">
            <label asp-for="Form.ObservacionesDiger">Observaciones DIGER</label>
            <textarea asp-for="Form.ObservacionesDiger" rows="3"></textarea>
        </div>

        <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:1rem">
            <a class="btns" asp-page="/Siger/Index">Cancelar</a>
            <button class="btnp" type="submit">@(Model.EsNuevo ? "Crear tramite" : "Guardar cambios")</button>
        </div>
    </form>
</div>

@section Scripts {
<style>
    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 16px;
    }
    .chk-label {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        padding: 8px 0;
    }
</style>
}
