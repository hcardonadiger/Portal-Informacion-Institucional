@using Diger.TramitesEstado.Application.Notificaciones
@using Diger.TramitesEstado.Application.Chat
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using Diger.TramitesEstado.Application.Usuarios.Queries.AutenticarUsuario
@using Diger.TramitesEstado.Infrastructure.Security
@using Diger.TramitesEstado.Web.Common
@using Diger.TramitesEstado.Application.Common.Models
@using Microsoft.Extensions.Options
@inject AccesoModulosService Acceso
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnv
@inject JerarquiaUiService JerarquiaUi
@inject IInstitucionBrandingService BrandingSvc
@inject INotificacionService _notifSvc
@inject IChatService chatSvc
@inject IApplicationDbContext ctx
@inject IOptions<InstitucionOptions> InstOpts
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var _activeInstId = User.FindFirstValue(AppClaims.ActiveInstitucion);
    var _instBranding = await BrandingSvc.GetAsync(_activeInstId);
    var _inst = InstOpts.Value;

    // ¿El contexto activo es la casa? El lockup de la cabecera ya ES el de la casa, así
    // que repetir su nombre al lado no informa; el rótulo solo gana su sitio cuando el
    // usuario está mirando OTRA institución.
    var _esLaCasa = string.Equals(_activeInstId, _inst.Id, StringComparison.OrdinalIgnoreCase);

    bool EsRuta(params string[] prefijos)
    {
        var path = Context.Request.Path;
        foreach (var p in prefijos)
        {
            if (p == "/") { if (path == "/" || path == "") return true; }
            else if (path.StartsWithSegments(p, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    string Iniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var s = partes.Length >= 2 ? $"{partes[0][0]}{partes[1][0]}" : partes[0][..Math.Min(2, partes[0].Length)];
        return s.ToUpperInvariant();
    }

    // El tema se resuelve ACÁ, antes del <head>, porque el <meta name="color-scheme">
    // de más abajo lo necesita: ese meta es lo que hace que el navegador pinte los
    // <select>, las barras de desplazamiento y los selectores de fecha en el tono
    // correcto, y son controles que el CSS de la página no alcanza a estilar.
    //
    // El modo oscuro conmutable anterior se eliminó el 2026-09-24 por una razón
    // concreta: dependía de un <script> que ponía data-theme en el <html> antes de
    // las hojas de estilo, y cuando no corría —un teléfono que lo bloquea, o que lo
    // ejecuta tarde— el registro público de asistencia salía oscuro. El defecto no
    // era el conmutador: era que la ELECCIÓN viajaba por JavaScript en el camino
    // crítico del pintado.
    //
    // Aquí la elección viaja en una cookie que lee el servidor, así que la clase ya
    // sale correcta en el HTML. Si el JS no corre, el botón no responde pero
    // ninguna página se pinta del color equivocado: es el modo de fallo seguro que
    // el diseño anterior no tenía.
    //
    // Una página se sale del tema declarando ViewData["BodyClass"]. Hoy solo lo
    // hace Asistencia/Registro, con "", que es el QR público: lo abre gente de
    // fuera, desde su teléfono, y tiene que salir claro siempre. Una página que
    // declara su clase no recibe la cookie NI el botón —queda fija— así que eximir
    // una página nueva sigue siendo una sola línea en la página.
    // CLARO POR OMISIÓN desde el 2026-10-19. El oscuro ya no es el estado de
    // salida: se pide con el botón y se recuerda en la cookie. Antes era al
    // revés —la cookie tenía que decir "claro" para aclarar—, y eso dejaba un
    // defecto visible en el login: su tarjeta tiene `background: #fff` fijo,
    // así que heredaba los tokens de texto CLAROS del tema oscuro sobre blanco
    // y, con `color-scheme: dark`, Chrome le pintaba encima el autorrelleno con
    // su paleta oscura. Letra clara sobre fondo claro.
    //
    // La condición se invierte entera: antes `!= "claro"`, ahora `== "oscuro"`.
    // Importa que sea comparación por igualdad y no negación: una cookie con
    // basura, o recortada, cae del lado claro, que es el seguro.
    var _claseDeclarada = ViewData["BodyClass"] as string;
    var _participaDelTema = _claseDeclarada is null;
    var _temaOscuro = _participaDelTema
        && Context.Request.Cookies["diger_tema"] == "oscuro";
    var _claseCuerpo = _participaDelTema
        ? (_temaOscuro ? "tema-oscuro" : "tema-claro")
        : _claseDeclarada;

    // El cajón del menú se ANCLA, y la elección viaja por el mismo camino que el tema:
    // una cookie que lee el servidor. No es capricho de simetría.
    //
    // En este portal cada enlace es una recarga completa. Si el anclaje viviera en
    // localStorage habría que reponerlo con un script después de pintar, y el contenido
    // daría un salto visible al abrir cada módulo —264px de corrimiento apareciendo
    // tarde— o, peor, se perdería al primer clic y el menú se desanclaría solo. Leída
    // acá, la clase ya sale en el HTML y la página nace corrida.
    //
    // El valor por omisión es ANCLADO desde el 2026-10-19. Antes era al revés
    // —el portal abría con el menú escondido y había que descubrir la
    // hamburguesa para sacarlo—, y eso convertía la navegación en algo que hay
    // que buscar. El menú es la estructura del portal: se ve, y quien no lo
    // quiera lo contrae con el mismo botón.
    //
    // La condición se invierte entera: antes `== "anclado"`, ahora
    // `!= "oculto"`. Importa el sentido: solo un "oculto" EXPLÍCITO —que
    // escribe el botón— lo esconde, así que una cookie con basura o recortada
    // cae del lado visible, que es el que no deja al usuario sin navegación.
    //
    // Bajo 900px esto no empuja nada: el CSS anula el corrimiento y el cajón
    // vuelve a ser pasajero, porque no hay 264px que ceder sin dejar el
    // contenido en una tira.
    var _cajonAnclado = Context.Request.Cookies["diger_menu"] != "oculto";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    @* ───────────────────────────────────────────────────────────────────────────────
       El tema de los controles que el CSS no alcanza a estilar: <select>, <option>,
       barras de desplazamiento y selectores de fecha. El navegador los pinta a partir
       de este <meta>, no de la hoja de estilos.

       Hasta el 2026-10-19 estaba clavado en "light" —herencia de cuando el portal era
       claro y nada más— y desde que el portal se puso oscuro eso era un defecto
       visible: un <select> blanco de sistema sobre el navy de la página.

       Lo importante es que sigue siendo DECLARATIVO y sale del servidor. El modo
       oscuro que se eliminó el 2026-09-24 ponía esto mismo por JavaScript antes de
       las hojas de estilo, y cuando el JS no corría el registro público de asistencia
       salía oscuro. Aquí el valor viene ya resuelto en el HTML.
       ─────────────────────────────────────────────────────────────────────────────── *@
    <meta name="color-scheme" content="@(_temaOscuro ? "dark" : "light")" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="@(_instBranding?.Color ?? "#02395e")" />
    <title>@ViewData["Title"] — @Marca.Nombre</title>

    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/favicon-192.png" asp-append-version="true">
    <link rel="icon" type="image/png" sizes="512x512" href="~/img/favicon-512.png" asp-append-version="true">
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/favicon-180.png" asp-append-version="true">

    @* Token Anti-CSRF disponible para peticiones AJAX/Fetch futuras *@
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
    @{ var token = Antiforgery.GetAndStoreTokens(Context).RequestToken; }
    <meta name="csrf-token" content="@token" />
    @* Las tipografías las sirve el propio portal (ver DESIGN.md §1.2 y
       wwwroot/fonts/LEEME.md). NO poner aquí un <link> a Google Fonts: la
       Content-Security-Policy de Program.cs declara `style-src 'self'` y
       `font-src 'self'`, de modo que el navegador lo bloquea y el portal cae
       al respaldo del sistema sin que nada falle ni avise. Eso fue
       exactamente lo que pasó mientras el enlace apuntó a Google: Poppins
       no se renderizó nunca. *@
    <link rel="stylesheet" href="~/css/fuentes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/diger.css" asp-append-version="true" />
    @if (_instBranding?.Color is { Length: > 0 } instColor)
    {
        <style>:root { --diger-blue: @instColor; --diger-blue-dark: @instColor; --diger-blue-mid: @instColor; }</style>
    }
</head>
<body class="@_claseCuerpo">
@* Cinta de entorno. En el mismo servidor conviven Ensayo y Producción y las pantallas son
   idénticas; sin este cartel, saber dónde está uno parado exige abrir la configuración. Se
   muestra siempre a propósito: en Ensayo tranquiliza, y en Producción avisa. *@
@{
    var _baseDatos = EntornoActual.BaseDeDatos(Config);
    var _esProdBd  = EntornoActual.EsProduccion(Config);
}
<div style="padding:3px 12px;font-size:11.5px;font-weight:600;letter-spacing:.02em;text-align:center;
            color:@(_esProdBd ? "#fff" : "#0f5132");
            background:@(_esProdBd ? "#b91c1c" : "#d1e7dd");
            border-bottom:1px solid @(_esProdBd ? "#7f1d1d" : "#a3cfbb")">
    @(_esProdBd ? "⚠ PRODUCCIÓN — datos reales" : "Entorno de pruebas") · base @_baseDatos
</div>
    <partial name="_IconSprite" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        var puedeTableros    = await Acceso.PuedeAsync(ModulosPortal.Tableros);
        var puedeCalendario  = await Acceso.PuedeAsync(ModulosPortal.Calendario);
        var puedeExpedientes = await Acceso.PuedeAsync(ModulosPortal.Expedientes);
        var puedeReuniones   = await Acceso.PuedeAsync(ModulosPortal.Reuniones);
        var puedeTickets     = await Acceso.PuedeAsync(ModulosPortal.Tickets);
        var puedeContactos   = await Acceso.PuedeAsync(ModulosPortal.Contactos);
        var puedeSoporte     = await Acceso.EsSoporteAsync();   // atiende el chat de soporte
        var puedeProyectos   = await Acceso.PuedeAsync(ModulosPortal.Proyectos);
        var puedeSiger       = await Acceso.PuedeAsync(ModulosPortal.Siger);

        // Honduras Simple se calcula una vez y no cuatro veces dentro del menú: son cuatro
        // módulos distintos y el grupo tiene que aparecer si el usuario alcanza cualquiera de
        // ellos. Gatearlo solo con "HondurasSimple.Ver" escondería el menú entero a quien
        // únicamente publica, que es un rol perfectamente razonable.
        var hsFichas         = await Acceso.PuedeAsync(ModulosPortal.HondurasSimple);
        var hsFichasEditar   = await Acceso.PuedeClaveAsync("HondurasSimple.Editar");
        var hsLlenado        = await Acceso.PuedeClaveAsync("HondurasSimple.Llenado.Ver");
        var hsConciliacion   = await Acceso.PuedeClaveAsync("HondurasSimple.Conciliacion.Editar");
        var hsPublicacion    = await Acceso.PuedeClaveAsync("HondurasSimple.Publicacion.Ver");
        var puedeHondurasSimple = hsFichas || hsFichasEditar || hsLlenado || hsConciliacion || hsPublicacion;

        var asignacionesJson = User.FindFirstValue(AppClaims.AsignacionesJson);
        List<AsignacionAuthDto>? asignaciones = null;
        if (!string.IsNullOrWhiteSpace(asignacionesJson))
        {
            try { asignaciones = JsonSerializer.Deserialize<List<AsignacionAuthDto>>(asignacionesJson); }
            catch { }
        }

        var rolFiltro = User.FindFirstValue(AppClaims.ActiveRol);
        bool showAsignaciones = asignaciones != null && asignaciones.Count > 1;
        bool showJerarquia = rolFiltro == "JefeInstitucion" || rolFiltro == "JefeArea";
        @* La franja de gobierno salió el 2026-10-19. Llevaba el eslogan
           —"Gobierno de la República de Honduras"— y la dirección del sitio, y
           las dos sobraban por la misma razón: el lockup oficial que va justo
           debajo YA dice GOBIERNO DE LA REPÚBLICA DE HONDURAS, con el escudo.
           Era la misma frase dos veces, una encima de la otra, y la de arriba
           en letra más chica. La dirección del portal no la necesita quien ya
           está dentro de él.

           Los 28px que ocupaba se le dieron al logo, que pasó de 40 a 56px: la
           cabecera entera baja de 91px a 79 y aun así la marca se ve más
           grande. Ver --diger-header-h en tokens.css.

           Quitarla además simplifica el cajón del menú: era lo único que hacía
           que la cabecera NO empezara en el borde superior, y por eso el cajón
           tenía que medir su posición en vez de leerla del token. *@
        @* nav-anclado es la clase que corre el contenido a la derecha del cajón. Va en el
           shell y no en el cajón porque lo que se mueve es el contenido, no el menú: el
           cajón está en position:fixed y ya sabe dónde pararse. *@
        <div class="app-shell @(_cajonAnclado ? "nav-anclado" : "")">
            <header class="app-header">
                <div class="app-header-inner">
                    @* El botón va ANTES de la marca: es el primer control de la página y
                       el único que abre el cajón, así que encabeza el orden de tabulación en
                       vez de quedar detrás del logo. aria-expanded y aria-controls son lo
                       único que dice si el cajón está abierto; toggleMainNav los mantiene
                       al día. *@
                    <button type="button" class="nav-toggle" id="navToggle"
                            onclick="toggleMainNav()"
                            aria-label="@(_cajonAnclado ? "Ocultar menú" : "Anclar menú")"
                            aria-expanded="@(_cajonAnclado ? "true" : "false")"
                            aria-controls="mainNav">&#9776;</button>

                    <a class="app-brand" asp-page="/Tableros/Index" title="Inicio">
                        @* El lockup oficial (escudo + Gobierno de la República + DIGER) sustituye
                           al dibujo de tres barras y a la palabra escrita: la marca ya la trae el
                           arte. Va el negativo, no el positivo: así el logo no necesita placa y se
                           apoya directo sobre el navy de la cabecera. *@
                        <img src="@_inst.LogoNegativo" class="app-brand-logo" alt="@(_inst.Eslogan) — @(_inst.NombreCorto)" />
                        @* En la casa, la marca termina en el logo: no se escribe el nombre del
                           producto —está en el título del navegador y en cada encabezado de
                           página— ni se repite "DIGER", que el logo ya dice. Fuera de la casa
                           entra el nombre de la institución activa, que es lo único que el logo
                           NO dice; el separador viaja con él, porque solo separa si hay algo
                           del otro lado. *@
                        @if (_instBranding is not null && !_esLaCasa)
                        {
                            <span class="app-brand-divider"></span>
                            if (!string.IsNullOrEmpty(_instBranding.LogoUrl))
                            {
                                <img src="@_instBranding.LogoUrl" class="app-brand-inst-logo"
                                     alt="@(_instBranding.NombreCorto ?? _instBranding.Nombre)" />
                            }
                            <span class="app-brand-inst">@(_instBranding.NombreCorto ?? _instBranding.Nombre)</span>
                        }
                    </a>

                    @* Anclado, el cajón nace ya desplegado: la clase viene del servidor y no de
                       un script, así que no hay un fotograma con el menú cerrado antes de que
                       el JS lo abra. La transición de .main-nav no se dispara —la clase ya
                       estaba al pintar—, que es justo lo que se quiere al cambiar de módulo. *@
                    <nav class="main-nav @(_cajonAnclado ? "open" : "")" id="mainNav" aria-label="Menú principal">
                        @*
                            Un grupo por pregunta que se hace el usuario: qué trabajo tengo, qué hay
                            en SIGER, qué estamos ejecutando, cómo vamos, qué tengo agendado, qué me
                            están pidiendo, y qué administro. Ningún menú pasa de seis entradas a
                            propósito: el grupo "Digitalización" anterior acumulaba nueve y mezclaba
                            las tres primeras. Por eso Proyectos abre su propio grupo en vez de
                            sumarse a Expedientes, que trata de racionalización de trámites.
                        *@
                        @if (puedeExpedientes)
                        {
                            var grpExp = EsRuta("/", "/Expedientes") || EsRuta("/PlanTrabajo") || EsRuta("/Recursos");
                            <div class="nav-group @(grpExp ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">Expedientes<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    <a class="nav-item @(EsRuta("/", "/Expedientes") ? "on" : "")" asp-page="/Index"><svg class="ico"><use href="#i-expediente"></use></svg>Expedientes</a>
                                    <a class="nav-item @(EsRuta("/PlanTrabajo") ? "on" : "")" asp-page="/PlanTrabajo/Index"><svg class="ico"><use href="#i-plan"></use></svg>Plan de Trabajo</a>
                                    <a class="nav-item @(EsRuta("/Recursos") ? "on" : "")" asp-page="/Recursos/Index"><svg class="ico"><use href="#i-recursos"></use></svg>Recursos y Plantillas</a>
                                </div>
                            </div>
                        }
                        @* SIGER quedó de sola consulta el 3 de septiembre de 2026: todo lo que
                           escribía se fue al grupo de abajo. Es el único grupo pensado para que
                           gente de fuera lo tenga, y por eso ahora se gatea con su propia clave
                           y no con Expedientes —antes, enseñar el inventario obligaba a regalar
                           Expedientes entero, y colgarlo de Expedientes mostraba el menú a quien
                           después recibía «Acceso denegado» al entrar—. *@
                        @if (puedeSiger)
                        {
                            <div class="nav-group @(EsRuta("/Siger") ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">SIGER<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    <a class="nav-item @(EsRuta("/Siger/Index") ? "on" : "")" asp-page="/Siger/Index"><svg class="ico"><use href="#i-inventario"></use></svg>Inventario</a>
                                    <a class="nav-item @(EsRuta("/Siger/Tablero") ? "on" : "")" asp-page="/Siger/Tablero"><svg class="ico"><use href="#i-grafica"></use></svg>Observatorio</a>
                                </div>
                            </div>
                        }
                        @* El trabajo del portal ciudadano. Seis entradas: el tope que este menú
                           se puso a propósito. El editor de fichas no está acá porque no se
                           empieza por él —se llega desde el inventario o desde una ficha—. *@
                        @if (puedeHondurasSimple)
                        {
                            <div class="nav-group @(EsRuta("/HondurasSimple") ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">Honduras Simple<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    @if (hsConciliacion)
                                    {
                                        <a class="nav-item @(EsRuta("/HondurasSimple/Conciliacion") ? "on" : "")" asp-page="/HondurasSimple/Conciliacion"><svg class="ico"><use href="#i-enlace"></use></svg>Conciliación</a>
                                    }
                                    @if (hsPublicacion)
                                    {
                                        <a class="nav-item @(EsRuta("/HondurasSimple/Publicacion") ? "on" : "")" asp-page="/HondurasSimple/Publicacion"><svg class="ico"><use href="#i-check"></use></svg>Publicado</a>
                                    }
                                    @if (hsLlenado)
                                    {
                                        <a class="nav-item @(EsRuta("/HondurasSimple/Llenado") ? "on" : "")" asp-page="/HondurasSimple/Llenado"><svg class="ico"><use href="#i-asignacion"></use></svg>Llenado asistido</a>
                                    }
                                    @if (hsFichas)
                                    {
                                        <a class="nav-item @(EsRuta("/HondurasSimple/Completitud") ? "on" : "")" asp-page="/HondurasSimple/Completitud"><svg class="ico"><use href="#i-estado"></use></svg>Completitud</a>
                                    }
                                    @if (hsFichasEditar)
                                    {
                                        <a class="nav-item @(EsRuta("/HondurasSimple/CapturaLote") ? "on" : "")" asp-page="/HondurasSimple/CapturaLote"><svg class="ico"><use href="#i-mas"></use></svg>Captura por lotes</a>
                                        <a class="nav-item @(EsRuta("/HondurasSimple/Archivo") ? "on" : "")" asp-page="/HondurasSimple/Archivo"><svg class="ico"><use href="#i-informe"></use></svg>Archivo del original</a>
                                    }
                                </div>
                            </div>
                        }
                        @if (puedeProyectos)
                        {
                            @* Dejó de ser un destino único: la biblioteca es la consulta
                               transversal de la documentación, y no cuelga de ningún proyecto. *@
                            <div class="nav-group @(EsRuta("/Proyectos") ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">Proyectos<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    <a class="nav-item @(EsRuta("/Proyectos") && !EsRuta("/Proyectos/Biblioteca") && !EsRuta("/Proyectos/MisActividades") && !EsRuta("/Proyectos/Plantillas") ? "on" : "")" asp-page="/Proyectos/Index">Portafolio</a>
                                    <a class="nav-item @(EsRuta("/Proyectos/MisActividades") ? "on" : "")" asp-page="/Proyectos/MisActividades">Mis actividades</a>
                                    @if (await Acceso.PuedeClaveAsync("Proyectos.Documentos.Ver"))
                                    {
                                        <a class="nav-item @(EsRuta("/Proyectos/Biblioteca") ? "on" : "")" asp-page="/Proyectos/Biblioteca">Biblioteca</a>
                                    }
                                    @* Plantillas de estructura, para los proyectos cíclicos.
                                       Va en Proyectos y no en Administración —donde están las de
                                       trámite— porque quien las necesita es quien formula
                                       proyectos. Su clave es propia, así que mantener plantillas
                                       no obliga a dar permiso sobre todos los proyectos. *@
                                    @if (await Acceso.PuedeClaveAsync("Proyectos.Plantillas.Ver"))
                                    {
                                        <a class="nav-item @(EsRuta("/Proyectos/Plantillas") ? "on" : "")" asp-page="/Proyectos/Plantillas">Plantillas</a>
                                    }
                                </div>
                            </div>
                        }
                        @if (puedeTableros || puedeExpedientes)
                        {
                            var grpTab = EsRuta("/Tableros") || EsRuta("/Informes");
                            <div class="nav-group @(grpTab ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">Tableros<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    @if (puedeTableros)
                                    {
                                        <a class="nav-item @(EsRuta("/Tableros/MiTablero") ? "on" : "")" asp-page="/Tableros/MiTablero"><svg class="ico"><use href="#i-tablero"></use></svg>Mi Tablero</a>
                                        <a class="nav-item @(EsRuta("/Tableros") && !EsRuta("/Tableros/MiTablero") ? "on" : "")" asp-page="/Tableros/Index"><svg class="ico"><use href="#i-grafica"></use></svg>Inicio</a>
                                    }
                                    @if (puedeExpedientes)
                                    {
                                        <a class="nav-item @(EsRuta("/Informes") ? "on" : "")" asp-page="/Informes/Index"><svg class="ico"><use href="#i-informe"></use></svg>Informes</a>
                                    }
                                </div>
