                        @* «Administración» agrupa lo que se administra: los datos maestros, que entran
                           por la portada de Catálogos, y el control de acceso. Los catálogos no cuelgan
                           uno por uno como antes —el menú crecía con cada uno— sino detrás de una sola
                           entrada; la portada decide qué tarjetas mostrar, y lo hace con la clave de
                           cada destino, no con el nombre del rol.

                           El grupo se abre para el administrador O para quien alcance algún catálogo.
                           Si dependiera solo de EsAdministrador, los roles que administran un catálogo
                           sin ser administradores —hoy varios tienen Tickets.Temas.Editar— se quedarían
                           sin ninguna puerta hacia él en el menú. Adentro, cada entrada se gatea por su
                           cuenta, así que un rol de esos ve Catálogos y nada más. *@
                        @{
                            var puedeInstituciones = await Acceso.PuedeAsync("Instituciones");
                            var puedeAreas         = await Acceso.PuedeAsync("Areas");
                            var puedeUnidades      = await Acceso.PuedeAsync("Unidades");
                            var puedeTemasTicket   = await Acceso.PuedeClaveAsync("Tickets.Temas.Editar");
                            var puedeCategorias    = await Acceso.PuedeClaveAsync("Categorias.Proyectos.Editar");
                            var puedePrioridades   = await Acceso.PuedeClaveAsync("Prioridades.Proyectos.Editar")
                                                  || await Acceso.PuedeClaveAsync("Prioridades.Tickets.Editar");

                            var puedeCatalogos = puedeInstituciones || puedeAreas || puedeUnidades
                                              || puedeTemasTicket || puedePrioridades || puedeCategorias;

                            // Cada entrada por su propia clave, no por «es administrador». Un rol
                            // puede tener Usuarios.Ver sin ser administrador, y antes eso no le
                            // abría nada: el menú miraba la capacidad del rol en vez de mirar el
                            // permiso de cada destino.
                            var puedeUsuarios = await Acceso.PuedeAsync("Usuarios");
                            var puedeRoles    = await Acceso.PuedeAsync("Accesos.Roles");
                            var puedePermisos = await Acceso.PuedeAsync("Accesos.Permisos");
                            var puedeModulos  = await Acceso.PuedeAsync("Accesos.Modulos");
                            // puedeMigrar salió con el enlace de "Migrar desde Supabase"
                            // (2026-10-19). Era lo único que lo usaba, y dejarlo habría
                            // mantenido vivo un permiso que ya no abre nada desde el menú.
                            // La guarda real vive en la página, que es donde importa.
                        }
                        @* Sin puedeMigrar en la condición: si se dejara, el grupo
                           Administración aparecería en Development para quien tenga esa
                           clave aunque no pueda ver ninguna de sus entradas, y se abriría
                           vacío. *@
                        @if (puedeCatalogos || puedeUsuarios || puedeRoles || puedePermisos || puedeModulos)
                        {
                            var grpAdmin = EsRuta("/Catalogos") || EsRuta("/Instituciones")
                                        || EsRuta("/Areas") || EsRuta("/Unidades")
                                        || EsRuta("/Usuarios") || EsRuta("/Accesos") || EsRuta("/Admin");
                            <div class="nav-group @(grpAdmin ? "on" : "")">
                                <button type="button" class="nav-group-btn" onclick="toggleNavGroup(this)">Administración<span class="nav-caret">&#9662;</span></button>
                                <div class="nav-group-menu">
                                    @if (puedeCatalogos)
                                    {
                                        <a class="nav-item @(EsRuta("/Catalogos", "/Instituciones", "/Areas", "/Unidades") ? "on" : "")" asp-page="/Catalogos/Index"><svg class="ico"><use href="#i-recursos"></use></svg>Catálogos</a>
                                    }
                                    @if (puedeUsuarios)
                                    {
                                        <a class="nav-item @(EsRuta("/Usuarios") ? "on" : "")" asp-page="/Usuarios/Index"><svg class="ico"><use href="#i-usuarios"></use></svg>Usuarios</a>
                                    }
                                    @if (puedeRoles)
                                    {
                                        <a class="nav-item @(EsRuta("/Accesos/Roles") ? "on" : "")" asp-page="/Accesos/Roles"><svg class="ico"><use href="#i-accesos"></use></svg>Roles</a>
                                    }
                                    @if (puedePermisos)
                                    {
                                        <a class="nav-item @(EsRuta("/Accesos/Permisos") ? "on" : "")" asp-page="/Accesos/Permisos"><svg class="ico"><use href="#i-accesos"></use></svg>Permisos</a>
                                    }
                                    @if (puedeModulos)
                                    {
                                        <a class="nav-item @(EsRuta("/Accesos/Modulos") ? "on" : "")" asp-page="/Accesos/Modulos"><svg class="ico"><use href="#i-accesos"></use></svg>Alcance de módulos</a>
                                    }
                                    @* "Migrar desde Supabase" salió del menú el 2026-10-19. Era una
                                       herramienta de traslado desde el portal demo, de un solo uso y
                                       ya hecha, y ocupaba un renglón permanente en Administración
                                       para algo que no se repite.

                                       La PÁGINA sigue existiendo en /Admin/MigrarSupabase con sus
                                       dos guardas intactas —solo en Development y solo con la clave
                                       Admin.Migraciones.Crear—, así que se llega escribiendo la
                                       dirección si hiciera falta reimportar. Quitar el enlace no
                                       quita la función: quita el recordatorio. *@
                                </div>
                            </div>
                        }

                        @* La ayuda va al final del menú y SIN condición de permiso: documenta cómo
                           se usa el portal, no expone datos de nadie —es la misma razón por la que
                           la página lleva [PermisoNoRequerido]—. Hasta ahora solo estaba dentro del
                           panel de usuario, donde no la encontraba quien no supiera que existía.
                           Un solo destino, así que enlaza directo en vez de desplegar un menú. *@
                        <div class="nav-group @(EsRuta("/Ayuda") ? "on" : "")">
                            <a class="nav-group-btn" asp-page="/Ayuda/Index" title="Manual de usuario del portal">Ayuda</a>
                        </div>
                    </nav>

