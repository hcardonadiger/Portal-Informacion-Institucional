@page
@model Diger.TramitesEstado.Web.Pages.Cuenta.PerfilModel
@{
    ViewData["Title"] = "Perfil";
    Layout = "_CuentaLayout";
}

<div class="card">
    <h3 class="cuenta-card-title">Datos personales</h3>

    <form method="post">
        <div class="field">
            <label>Nombre completo</label>
            <input asp-for="Nombre" required maxlength="150" />
            <span asp-validation-for="Nombre" class="text-error"></span>
        </div>

        <div class="field">
            <label>Correo institucional (usuario de acceso)</label>
            <input asp-for="Correo" type="email" required maxlength="200" />
            <span asp-validation-for="Correo" class="text-error"></span>
        </div>

        <div class="field">
            <label>Teléfono</label>
            <input asp-for="Telefono" maxlength="50" placeholder="+504 0000-0000" />
            <span asp-validation-for="Telefono" class="text-error"></span>
        </div>

        <div style="margin-top:1.5rem">
            <button type="submit" class="btnp">Guardar cambios</button>
        </div>
    </form>

    <h3 class="cuenta-card-title" style="margin-top:2rem">Contexto institucional</h3>

    @if (Model.SinAsignacion)
    {
        <div class="alert-error" style="margin:.4rem 0 1rem">
            <strong>Tu cuenta todavía no tiene institución ni rol asignado.</strong>
            Podés entrar y administrar tus datos personales, pero el resto del portal te va a
            responder «acceso denegado» hasta que un administrador te asigne una institución
            desde <em>Usuarios</em>.
        </div>
    }
    else
    {
        <p style="font-size:12px;color:var(--diger-text-muted);margin:-0.4rem 0 1rem">
            Tu institución, área y rol los asigna un administrador. Para cambiarlos, contacta a soporte.
        </p>
    }

    <div class="cuenta-readonly-grid">
        <div>
            <span class="cuenta-ro-label">Rol</span>
            <span class="cuenta-ro-value">@(string.IsNullOrWhiteSpace(Model.RolActivo) ? "—" : Model.RolActivo)</span>
        </div>
        <div>
            <span class="cuenta-ro-label">Institución</span>
            <span class="cuenta-ro-value">@(string.IsNullOrWhiteSpace(Model.InstitucionActiva) ? "—" : Model.InstitucionActiva)</span>
        </div>
        <div>
            <span class="cuenta-ro-label">Área</span>
            <span class="cuenta-ro-value">@(string.IsNullOrWhiteSpace(Model.AreaActiva) ? "—" : Model.AreaActiva)</span>
        </div>
        <div>
            <span class="cuenta-ro-label">Unidad</span>
            <span class="cuenta-ro-value">@(string.IsNullOrWhiteSpace(Model.UnidadActiva) ? "—" : Model.UnidadActiva)</span>
        </div>
    </div>
</div>

<div class="card" style="margin-top:1rem">
    <h3 style="margin-top:0">Microsoft Outlook</h3>
    @if (!string.IsNullOrEmpty(Model.OutlookAviso))
    {
        <div class="alert-warn">@Model.OutlookAviso</div>
    }
    @if (!Model.Outlook.Configurada)
    {
        <p class="hint">La integración con Outlook no está configurada en este servidor. Pídasela a TI.</p>
    }
    else if (!Model.Outlook.Conectada)
    {
        <p class="hint">Conecte su cuenta @@diger.gob.hn para enviar reuniones a su calendario de Outlook, con reunión de Teams.
            Se inicia sesión en la página de Microsoft: el portal nunca ve su contraseña.</p>
        <form method="post" asp-page-handler="ConectarOutlook">
            <button type="submit" class="btnp">Conectar mi Outlook</button>
        </form>
    }
    else
    {
        @if (Model.Outlook.RequiereReconexion)
        {
            <div class="alert-warn">Su conexión venció. Las reuniones que envió no se actualizarán hasta que reconecte.</div>
        }
        <p>Conectado como <strong>@Model.Outlook.Upn</strong>
           <span class="hint">desde @Model.Outlook.ConectadaEl?.ToLocalTime().ToString("dd/MM/yyyy")</span></p>
        <div style="display:flex;gap:8px">
            <form method="post" asp-page-handler="ConectarOutlook">
                <button type="submit" class="btns">@(Model.Outlook.RequiereReconexion ? "Reconectar" : "Cambiar de cuenta")</button>
            </form>
            <form method="post" asp-page-handler="DesconectarOutlook">
                <button type="submit" class="btns">Desconectar</button>
            </form>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
