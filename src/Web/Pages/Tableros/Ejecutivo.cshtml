@page
@using System.Globalization
@using Diger.TramitesEstado.Application.Dashboards.Queries.GetEjecutivoProyectos
@inject AccesoModulosService Acceso
@model Diger.TramitesEstado.Web.Pages.Tableros.EjecutivoModel
@{
    ViewData["Title"] = "Tablero ejecutivo de proyectos";
    var d = Model.Data;
    var c = Model.Contexto;
    var inst = Model.Institucion;
    var inv = CultureInfo.InvariantCulture;

    var calculado = d.CalculadoEnUtc.ToLocalTime();
    int? diasUltimo = d.UltimoReporte is { } ur ? (int)(d.CalculadoEnUtc - ur).TotalDays : null;
    var desactualizado = diasUltimo is null || diasUltimo > ProyectoEstadoReglas.DiasSinReporte;

    var puedeOperativo = await Acceso.PuedeClaveAsync("Proyectos.Ver");
    var puedeCrear     = d.Total == 0 && await Acceso.PuedeClaveAsync("Proyectos.Crear");

    string ClaseSalud(SaludProyecto s) => s switch
    {
        SaludProyecto.Rojo  => "rojo",
        SaludProyecto.Ambar => "ambar",
        SaludProyecto.Verde => "verde",
        _                   => "neutro"
    };
    string? IconoSalud(SaludProyecto s) => s switch
    {
        SaludProyecto.Rojo  => "i-alerta",
        SaludProyecto.Ambar => "i-vencido",
        SaludProyecto.Verde => "i-check",
        _                   => null
    };
    // La fila solo dice cuánto va: el esperado, la desviación y la línea base se leen en el
    // tablero del proyecto, a un clic. La marca de la barra sigue mostrando el esperado.
    // El porcentaje siempre ocupa su sitio; sin entregables no hay avance que medir y va «—».
    string Cifras(ProyectoEjecutivoDto p) =>
        p.SinEstructura ? "—" : $"{p.AvancePct} %";
    string AriaBarra(ProyectoEjecutivoDto p)
    {
        if (p.SinEstructura) return "Sin dato de avance: el proyecto no tiene entregables cargados";
        if (p.AvanceEsperado is not { } e) return $"Avance {p.AvancePct} por ciento, sin línea base";
        var dv = p.Desviacion!.Value;
        var rel = dv < 0 ? $"{-dv} puntos por detrás del plan" : dv > 0 ? $"{dv} puntos por delante del plan" : "en el plan";
        return $"Avance {p.AvancePct} por ciento, esperado {e}, {rel}";
    }
    string Corto(string t, int max) => t.Length <= max ? t : t[..max].TrimEnd() + "…";

    // Un solo color por estado para la dona, su leyenda y las barras de la lista: la barra dice en
    // qué etapa va el proyecto y la etiqueta de la derecha, cómo va. Son tokens, así que cambian
    // solos con el tema. Sin dato (sin entregables) no pinta barra: queda el riel gris.
    string ColorEstado(EstadoProyecto e) => e switch
    {
        EstadoProyecto.Cerrado     => "var(--diger-estado-fin)",
        EstadoProyecto.EnEjecucion => "var(--diger-estado-proceso)",
        EstadoProyecto.Planificado => "var(--diger-estado-pendiente)",
        EstadoProyecto.Suspendido  => "var(--diger-warning-strong)",
        _                          => "var(--diger-text-slate-dark)"
    };

    // Bloqueos por proyecto: reportes que declararon un bloqueo, en toda la historia.
    const int MaxBloqueos = 10;
    var conBloqueos = d.Proyectos.Where(p => p.BloqueosRegistrados > 0)
        .OrderByDescending(p => p.BloqueosRegistrados).ThenBy(p => p.Nombre).ToList();
    var maxBloqueos = conBloqueos.Count == 0 ? 1 : conBloqueos[0].BloqueosRegistrados;
    var totalBloqueos = conBloqueos.Sum(p => p.BloqueosRegistrados);
    var tramos = new List<string>();
    var acumulado = 0.0;
    foreach (var s in d.PorEstado)
    {
        var desde = acumulado;
        acumulado += d.Total == 0 ? 0 : s.Cantidad * 100.0 / d.Total;
        tramos.Add($"{ColorEstado(s.Estado)} {desde.ToString("0.##", inv)}% {acumulado.ToString("0.##", inv)}%");
    }
    var dona = tramos.Count == 0 ? "var(--diger-bg-soft)" : $"conic-gradient({string.Join(", ", tramos)})";

    const int MaxDecisiones = 10;
    // R8: 140 caracteres son tres líneas en la columna de 1/3; el resto va en el title.
    const int MaxTextoDecision = 140;

    // R2: rojo, ámbar y verde siempre a la vista; lo neutro (no se mide contra el plan) se pliega.
    var visibles = d.Proyectos.Where(p => p.Salud != SaludProyecto.Neutro).ToList();
    var neutros  = d.Proyectos.Where(p => p.Salud == SaludProyecto.Neutro).ToList();
    string GrupoNeutro()
    {
        var partes = new[] { ("Finalizado", "finalizados"), ("No iniciado", "no iniciados"), ("Sin dato", "sin dato"), ("Cancelado", "cancelados") }
            .Where(x => neutros.Any(p => p.EtiquetaSalud == x.Item1))
            .Select(x => x.Item2)
            .ToList();
        var texto = partes.Count <= 1 ? string.Join("", partes)
            : string.Join(", ", partes.Take(partes.Count - 1)) + " y " + partes[^1];
        return texto.Length == 0 ? texto : char.ToUpper(texto[0]) + texto[1..];
    }
    // Unidad o responsable: lo que de verdad se aplicó, con el nombre de su opción.
    var unidadSel = d.Unidades.FirstOrDefault(o => o.Id == d.UnidadAplicada);
    var respSel   = d.Responsables.FirstOrDefault(o => o.Id == d.ResponsableAplicado?.ToString());
    var subfiltro = unidadSel is not null ? $"Unidad: {unidadSel.Nombre}"
                  : respSel   is not null ? $"Responsable: {respSel.Nombre}"
                  : null;
    // «Solo estos proyectos»: lo aplicado, con su texto para el botón y la hoja impresa.
    var elegidos = d.ProyectosAplicados.ToHashSet();
    string? proyTexto = elegidos.Count == 0 ? null
                      : $"{elegidos.Count} {(elegidos.Count == 1 ? "proyecto elegido" : "proyectos elegidos")}";
    var filtrosTexto = $"Área: {c.AreaNombre ?? "todas"} · Categoría: {c.CategoriaNombre ?? "todas"}"
                     + (subfiltro is null ? "" : $" · {subfiltro}")
                     + (proyTexto is null ? "" : $" · {proyTexto}");

    // Lo pedido que no aplica en esta cartera: se conserva en la URL (vuelve a aplicarse al cambiar
    // de categoría o de área) y se avisa, para que la lista completa no parezca un filtro roto.
    var noAplican = new List<string>();
    if (Model.Unidad is not null && d.UnidadAplicada is null) noAplican.Add("la unidad elegida");
    if (Model.Responsable is not null && d.ResponsableAplicado is null) noAplican.Add("el responsable elegido");
    if (Model.Proyecto.Count > 0 && elegidos.Count == 0) noAplican.Add("los proyectos elegidos");
    string? avisoNoAplica = null;
    if (noAplican.Count > 0)
    {
        var quien = string.Join(" ni ", noAplican);
        var verbo = noAplican.Count == 1 && !noAplican[0].StartsWith("los") ? "tiene" : "tienen";
        var donde = c.CategoriaNombre is null ? "esta cartera" : $"la categoría {c.CategoriaNombre}";
        avisoNoAplica = $"{char.ToUpper(quien[0])}{quien[1..]} no {verbo} proyectos en {donde}: se muestra completa. "
                      + "El filtro se conserva y vuelve a aplicarse donde corresponda.";
    }
}

<div class="container ejec">
    <div class="hist-header ejec-cab">
        <div>
            <img class="ejec-logo-impreso" src="@inst.Logo" alt="@inst.NombreCorto" />
            <h2>@c.Titulo</h2>
            <p>Seguimiento de avance, salud y decisiones · @d.Total @(d.Total == 1 ? "proyecto" : "proyectos") · @inst.NombreCorto</p>
            <p class="ejec-filtros-impresos">@filtrosTexto</p>
        </div>
        <div class="ejec-cab-der">
            <div class="ejec-chips">
                <span class="ejec-chip">Calculado al @FormatoEjecutivo.FechaHora(calculado)</span>
                <span class="ejec-chip @(desactualizado ? "is-viejo" : "")"
                      title="Último reporte de avance registrado en esta cartera">
                    Último reporte:
                    @if (d.UltimoReporte is { } u)
                    {
                        @FormatoEjecutivo.FechaLarga(u.ToLocalTime())
                        @if (desactualizado) { <text> · @FormatoEjecutivo.Hace(diasUltimo!.Value)</text> }
                    }
                    else
                    {<text>sin reportes</text>}
                </span>
            </div>
            <div class="ejec-acciones">
                <button type="button" class="btns" onclick="window.print()">Imprimir</button>
                @if (puedeOperativo)
                {
                    <a class="btns" asp-page="/Tableros/Proyectos">Seguimiento operativo →</a>
                }
            </div>
        </div>
    </div>

    @* Barra fija: la categoría es la primera decisión de quien mira el tablero y se queda a la
       vista al bajar. Unidad o responsable se eligen DENTRO de la categoría: el menú solo ofrece
       las que tienen proyectos en ella. Son enlaces, no un formulario: funcionan sin JS. *@
    <div class="ejec-barra-filtros ejec-filtros">
        <nav class="ejec-cats" aria-label="Categoría">
            <span class="ejec-barra-lbl">Categoría</span>
            <a class="ejec-cat @(c.CategoriaId is null ? "is-on" : "")" href="@Model.Enlace(null)"
               aria-current="@(c.CategoriaId is null ? "page" : null)">Todas</a>
            @foreach (var cat in c.Categorias)
            {
                var on = c.CategoriaId == cat.Id;
                <a class="ejec-cat @(on ? "is-on" : "")" href="@Model.Enlace(cat.Id)" aria-current="@(on ? "page" : null)">
                    <span class="@Diger.TramitesEstado.Application.Dashboards.Queries.Etiquetas.ClaseColor(cat.Color) ejec-cat-punto" aria-hidden="true"></span>@cat.Nombre
                </a>
            }
        </nav>

        <details class="ejec-sub @(subfiltro is null ? "" : "is-on")">
            <summary class="ejec-sub-btn">
                <svg class="ico" aria-hidden="true"><use href="#i-usuarios"></use></svg>
                <span>@(subfiltro ?? "Unidad o responsable")</span>
                <svg class="ico ejec-sub-flecha" aria-hidden="true"><use href="#i-chevron"></use></svg>
            </summary>
            <div class="ejec-sub-panel">
                @if (subfiltro is not null)
                {
                    <a class="ejec-sub-todo" href="@Model.EnlaceSub(null, null)">Ver toda @(c.CategoriaNombre is null ? "la cartera" : $"la categoría {c.CategoriaNombre}")</a>
                }
                @if (d.Unidades.Count == 0 && d.Responsables.Count == 0)
                {
                    <p class="res-meta">No hay unidades ni responsables asignados en esta cartera.</p>
                }
                @if (d.Unidades.Count > 0)
                {
                    <div class="ejec-sub-grupo">
                        <h4><svg class="ico" aria-hidden="true"><use href="#i-unidad"></use></svg>Unidad</h4>
                        @foreach (var o in d.Unidades)
                        {
                            <a class="@(o.Id == d.UnidadAplicada ? "is-on" : "")" href="@Model.EnlaceSub(o.Id, null)">
                                <span>@o.Nombre</span><strong>@o.Cantidad</strong>
                            </a>
                        }
                    </div>
                }
                @if (d.Responsables.Count > 0)
                {
                    <div class="ejec-sub-grupo">
                        <h4><svg class="ico" aria-hidden="true"><use href="#i-usuarios"></use></svg>Responsable</h4>
                        @foreach (var o in d.Responsables)
                        {
                            <a class="@(o.Id == d.ResponsableAplicado?.ToString() ? "is-on" : "")" href="@Model.EnlaceSub(null, Guid.Parse(o.Id))">
                                <span>@o.Nombre</span><strong>@o.Cantidad</strong>
                            </a>
                        }
                    </div>
                }
            </div>
        </details>

        @* «Solo estos proyectos»: casillas sobre la cartera ya recortada por los filtros de arriba y
           por el alcance del rol. Es un formulario GET que lleva el resto del recorte en ocultos;
           sin marcar ninguna se ve la cartera entera. *@
        <details class="ejec-sub ejec-proy @(proyTexto is null ? "" : "is-on")">
            <summary class="ejec-sub-btn">
                <svg class="ico" aria-hidden="true"><use href="#i-plan"></use></svg>
                <span>@(proyTexto ?? "Proyectos")</span>
                <svg class="ico ejec-sub-flecha" aria-hidden="true"><use href="#i-chevron"></use></svg>
            </summary>
            <form method="get" action="/Tableros/Ejecutivo" class="ejec-sub-panel ejec-proy-panel">
                @if (Request.Query.ContainsKey("Area")) { <input type="hidden" name="Area" value="@Model.Area" /> }
                @if (c.CategoriaId is { } catP) { <input type="hidden" name="Categoria" value="@catP" /> }
                @if (Model.Unidad is not null) { <input type="hidden" name="Unidad" value="@Model.Unidad" /> }
                @if (Model.Responsable is not null) { <input type="hidden" name="Responsable" value="@Model.Responsable" /> }
                @if (d.ProyectosDisponibles.Count == 0)
                {
                    <p class="res-meta">No hay proyectos en esta cartera.</p>
                }
                else
                {
                    <p class="res-meta ejec-proy-ayuda">Marque los proyectos que quiere ver: todo el tablero se calcula solo con ellos. Sin marcar, se ven todos.</p>
                    <div class="ejec-proy-herr" hidden>
                        <input type="search" class="ejec-proy-buscar" placeholder="Buscar proyecto…" aria-label="Buscar proyecto" />
                        <button type="button" class="ejec-proy-marcar" data-marcar="1">Marcar todos</button>
                        <button type="button" class="ejec-proy-marcar" data-marcar="0">Ninguno</button>
                    </div>
                    <div class="ejec-proy-lista">
                        @foreach (var o in d.ProyectosDisponibles)
                        {
                            <label class="ejec-proy-op"><input type="checkbox" name="Proyecto" value="@o.Id" checked="@elegidos.Contains(o.Id)" /><span>@o.Nombre</span><small>@o.Codigo</small></label>
                        }
                    </div>
                    <div class="ejec-proy-pie">
                        <button type="submit" class="btnp">Aplicar</button>
                        @if (proyTexto is not null)
                        {
                            <a href="@Model.EnlaceSinProyectos()">Ver todos</a>
                        }
                    </div>
                }
            </form>
        </details>

        @if (c.PuedeElegirArea)
        {
            <form method="get" class="ejec-area">
                @if (c.CategoriaId is { } catId) { <input type="hidden" name="Categoria" value="@catId" /> }
                @if (Model.Unidad is not null) { <input type="hidden" name="Unidad" value="@Model.Unidad" /> }
                @if (Model.Responsable is not null) { <input type="hidden" name="Responsable" value="@Model.Responsable" /> }
                @foreach (var pid in Model.Proyecto.Distinct()) { <input type="hidden" name="Proyecto" value="@pid" /> }
                <label for="f-area" class="ejec-barra-lbl">Área</label>
                <select id="f-area" name="Area" onchange="this.form.submit()">
                    <option value="" selected="@(c.AreaId is null)">Todas las áreas</option>
                    @foreach (var a in c.Areas)
                    {
                        <option value="@a.Id" selected="@(c.AreaId == a.Id)">@a.Nombre@(a.Activo ? "" : " (inactiva)")</option>
                    }
                </select>
            </form>
        }
        @if (Model.HayFiltro)
        {
            <a class="ejec-limpiar" asp-page="/Tableros/Ejecutivo">Limpiar</a>
        }
    </div>
    @if (avisoNoAplica is not null)
    {
        <p class="res-meta ejec-aviso" role="status">@avisoNoAplica</p>
    }

    <partial name="_KpiEjecutivo" model="d" />

    @if (d.Total == 0)
    {
        <div class="dash-card">
            <div class="empty-state">
                <div class="empty-state-ico"><svg class="ico"><use href="#i-plan"></use></svg></div>
                <div class="empty-state-t1">No hay proyectos en @(c.AreaNombre ?? inst.NombreCorto)@(c.CategoriaNombre is null ? "" : $" · {c.CategoriaNombre}") con estos filtros</div>
                <div class="empty-state-t2">
                    <a asp-page="/Tableros/Ejecutivo">Limpiar filtros</a>
                    @if (puedeCrear)
                    {<text> · </text><a asp-page="/Proyectos/Editor">Crear proyecto →</a>}
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ejec-grid">
            <section class="dash-card ejec-lista-card" id="ejec-lista" aria-labelledby="ejec-lista-t">
                <div class="ejec-lista-cab">
                    <h3 id="ejec-lista-t">Avance y salud por proyecto</h3>
                    <ul class="ejec-leyenda-linea" aria-label="Color de la barra según el estado">
                        @foreach (var s in d.PorEstado)
                        {
                            <li><span class="ejec-cuadro" style="background:@ColorEstado(s.Estado)"></span>@s.Etiqueta</li>
                        }
                        @if (d.SinEstructura > 0)
                        {<li><span class="ejec-cuadro is-sin-dato"></span>Sin dato</li>}
                    </ul>
                </div>
                @{
                    // Fila (R2): arriba el nombre y, donde iba el código, responsable y unidad; debajo
                    // una barra corta, pintada por estado, con su porcentaje. La salud, a la derecha.
                    void Fila(ProyectoEjecutivoDto p, int n)
                    {
                        var icono = IconoSalud(p.Salud);
                        // Sin código, «último reporte» ni motivo de la salud: son el detalle del
                        // proyecto y viven en su tablero; aquí hacían ruido en cada fila.
                        var sub = new List<string> { p.Responsable ?? "sin responsable" };
                        if (d.UnidadAplicada is null) sub.Add(p.UnidadEtiqueta ?? "sin unidad");
                        <li class="ejec-fila">
                            <a class="ejec-fila-link" href="/Tableros/Proyecto/@p.ProyectoId">
                                <span class="ejec-num">@n</span>
                                <span class="ejec-fila-cuerpo">
                                    <span class="ejec-titulo"><span class="ejec-nombre">@p.Nombre</span> <span class="ejec-resp">@for (var i = 0; i < sub.Count; i++) { if (i > 0) {<text> · </text>} <span>@sub[i]</span> }</span></span>
                                    <span class="ejec-avance">
                                        <span class="bar-track ejec-barra" role="img" aria-label="@AriaBarra(p)">
                                            @if (!p.SinEstructura)
                                            {<span class="bar-fill" style="width:@(Math.Clamp(p.AvancePct, 0, 100))%;background:@ColorEstado(p.Estado)"></span>}
                                            @if (p.AvanceEsperado is { } esp)
                                            {<span class="bar-mark" style="left:@(Math.Clamp(esp, 0, 100))%"></span>}
                                        </span>
                                        <span class="ejec-cifras @(p.SinEstructura ? "is-sin-dato" : "")" title="@(p.SinEstructura ? "sin entregables cargados" : null)">@Cifras(p)</span>
                                    </span>
                                </span>
                                <span class="salud-badge @ClaseSalud(p.Salud)" title="@p.MotivoSalud">@if (icono is not null) {<svg class="ico" aria-hidden="true"><use href="#@icono"></use></svg>}@p.EtiquetaSalud</span>
                            </a>
                        </li>
                    }
                }
                @if (visibles.Count > 0)
                {
                    <ol class="ejec-lista">
                        @for (var k = 0; k < visibles.Count; k++) { Fila(visibles[k], k + 1); }
                    </ol>
                }
                @if (neutros.Count > 0)
                {
                    @* Se sirve abierto y el script lo cierra en pantalla: sin JS queda abierto, que es el
                       modo de fallo seguro, y al imprimir se vuelve a abrir (R2, R10). *@
                    <details class="ejec-neutros" open>
                        <summary>@GrupoNeutro() (@neutros.Count) — <span class="ejec-neutros-mostrar">mostrar</span><span class="ejec-neutros-ocultar">ocultar</span></summary>
                        <ol class="ejec-lista" start="@(visibles.Count + 1)">
                            @for (var k = 0; k < neutros.Count; k++) { Fila(neutros[k], visibles.Count + k + 1); }
                        </ol>
                    </details>
                }
            </section>

            <div class="ejec-lateral">
                <section class="dash-card" aria-labelledby="ejec-dona-t">
                    <h3 id="ejec-dona-t">Estado de los proyectos</h3>
                    <div class="ejec-dona-caja">
                        <div class="ejec-dona" style="background:@dona" aria-hidden="true">
                            <span class="ejec-dona-centro"><strong>@d.Total</strong><span>@(d.Total == 1 ? "proyecto" : "proyectos")</span></span>
                        </div>
                        <ul class="ejec-leyenda">
                            @foreach (var s in d.PorEstado)
                            {
                                <li><span class="ejec-cuadro" style="background:@ColorEstado(s.Estado)"></span><span>@s.Etiqueta</span><strong>@s.Cantidad</strong></li>
                            }
                        </ul>
                    </div>
                    @if (d.SinEstructura > 0)
                    {
                        <p class="res-meta ejec-nota">@d.SinEstructura sin entregables (sin dato de avance)</p>
                    }
                </section>

                <section class="dash-card" id="ejec-bloqueos" aria-labelledby="ejec-bloq-t">
                    <h3 id="ejec-bloq-t">Bloqueos por proyecto</h3>
                    @if (conBloqueos.Count == 0)
                    {
                        <p class="res-meta">Ningún reporte de avance ha declarado un bloqueo.</p>
                    }
                    else
                    {
                        <ol class="ejec-bloqueos">
                            @foreach (var p in conBloqueos.Take(MaxBloqueos))
                            {
                                <li>
                                    <a class="ejec-bloq-nombre" href="/Tableros/Proyecto/@p.ProyectoId" title="@p.Nombre">@p.Nombre</a>
                                    <span class="ejec-bloq-barra" aria-hidden="true"><span style="width:@((p.BloqueosRegistrados * 100.0 / maxBloqueos).ToString("0.#", inv))%"></span></span>
                                    <strong class="ejec-bloq-n">@p.BloqueosRegistrados</strong>
                                </li>
                            }
                        </ol>
                        <p class="res-meta ejec-nota">
                            @totalBloqueos @(totalBloqueos == 1 ? "bloqueo registrado" : "bloqueos registrados") en @conBloqueos.Count @(conBloqueos.Count == 1 ? "proyecto" : "proyectos")@if (conBloqueos.Count > MaxBloqueos) {<text>; se muestran los @MaxBloqueos con más</text>}.
                            @(d.Total - conBloqueos.Count) sin bloqueos.
                        </p>
                    }
                </section>

                <section class="dash-card" id="ejec-decisiones" aria-labelledby="ejec-dec-t">
                    <h3 id="ejec-dec-t">Necesita decisión (@d.Decisiones.Count)</h3>
                    @if (d.Decisiones.Count == 0)
                    {
                        <p class="res-meta">Ningún proyecto reporta bloqueos vigentes, cierres vencidos ni trabajo arrancado con dependencias abiertas.</p>
                    }
                    else
                    {
                        <ol class="ejec-decisiones">
                            @foreach (var x in d.Decisiones.Take(MaxDecisiones))
                            {
                                var ico = x.Tipo switch
                                {
                                    TipoDecision.BloqueoVigente => "i-alerta",
                                    TipoDecision.CierreVencido  => "i-vencido",
                                    _                           => "i-enlace"
                                };
                                <li class="ejec-decision tipo-@x.Tipo.ToString().ToLowerInvariant()">
                                    <svg class="ico ejec-dec-ico" aria-hidden="true"><use href="#@ico"></use></svg>
                                    <div>
                                        <div class="ejec-dec-cab">
                                            <a href="/Tableros/Proyecto/@x.ProyectoId">@x.Proyecto</a>
                                            @if (x.Tipo != TipoDecision.CierreVencido)
                                            {<span class="res-meta"> · @FormatoEjecutivo.Hace(x.Dias)</span>}
                                        </div>
                                        <div class="ejec-dec-tx" title="@(x.Texto.Length > MaxTextoDecision ? x.Texto : null)">@Corto(x.Texto, MaxTextoDecision)</div>
                                        @if (x.Autor is not null)
                                        {<div class="res-meta ejec-dec-autor">— @x.Autor</div>}
                                    </div>
                                </li>
                            }
                        </ol>
                        @if (d.Decisiones.Count > MaxDecisiones && puedeOperativo)
                        {
                            <a class="ejec-mas" asp-page="/Tableros/Proyectos">ver @(d.Decisiones.Count - MaxDecisiones) más en seguimiento operativo →</a>
                        }
                    }
                </section>
            </div>
        </div>
    }

    <footer class="res-meta ejec-pie">
        <p>
            Fuente: módulo Proyectos de @inst.NombreCorto. Avance real = promedio de los entregables de cada
            proyecto (los que no tienen actividades valen por su estado: 0, 50 o 100). Esperado = interpolación
            de las actividades con fechas planificadas; por eso real y esperado no promedian lo mismo, como en el
            tablero de cada proyecto. Datos filtrados por el alcance de su rol. Datos para seguimiento interno.
        </p>
        <details class="ejec-reglas">
            <summary>Reglas del semáforo</summary>
            <p>Se aplica la primera regla que se cumple; el color siempre va con su etiqueta.</p>
            <ol>
                <li><strong>Finalizado</strong>, <strong>Cancelado</strong> o <strong>Sin dato</strong> (sin entregables cargados): gris, no se mide contra el plan.</li>
                <li><strong>Vencido</strong> (rojo): pasó la fecha de cierre planificada y el proyecto sigue abierto.</li>
                <li><strong>Bloqueado</strong> (rojo): el último reporte de avance declara un bloqueo.</li>
                <li><strong>Atrasado</strong> (rojo): @(-ProyectoEstadoReglas.DesviacionRoja) puntos o más por detrás de lo esperado a la fecha.</li>
                <li><strong>En riesgo</strong> (ámbar): entre @(-ProyectoEstadoReglas.DesviacionAmbar) y @(-ProyectoEstadoReglas.DesviacionRoja - 1) puntos por detrás.</li>
                <li><strong>Sin reportar</strong> (ámbar): en ejecución y sin reportes en los últimos @ProyectoEstadoReglas.DiasSinReporte días.</li>
                <li><strong>Suspendido</strong> (ámbar).</li>
                <li><strong>Sin línea base</strong> (ámbar): en ejecución sin fecha de cierre comprometida o sin fechas en sus actividades; no hay contra qué comparar.</li>
                <li><strong>No iniciado</strong> (gris): planificado. Si ya muestra avance, es un dato por corregir en la ficha.</li>
                <li><strong>En plan</strong> (verde): todo lo demás.</li>
            </ol>
            <p>La prioridad del proyecto no cambia su color. El color de cada barra es el estado del proyecto; la marca vertical, el avance esperado hoy.</p>
        </details>
        <p>Trabajo futuro: tendencia mensual del avance.</p>
    </footer>
</div>

@section Scripts {
<style>
    @@page { size: A4 landscape; margin: 12mm; }
    @@media print {
        .app-header, .main-nav, .diger-footer, .chat-widget,
        .ejec-filtros, .ejec-acciones, .ejec .tablero-marca, .ejec-reglas:not([open]) { display: none !important; }
        .ejec-logo-impreso, .ejec-filtros-impresos { display: block !important; }
        /* R10: la columna lateral (dona y decisiones) va antes que la lista, para que la primera
           hoja tenga KPI + estado + decisiones y las siguientes la lista completa. */
        .ejec-grid { display: flex !important; flex-direction: column; }
        .ejec-lateral { order: -1; }
        .ejec-neutros > summary { display: none; }
        .ejec-lateral > .dash-card, .ejec-lista-card { margin-bottom: 12px; }
        .ejec-fila, .ejec-decision, .ejec-bloqueos li { break-inside: avoid; }
        .ejec .bar-fill, .ejec .bar-mark, .ejec .salud-badge, .ejec-dona, .ejec-cuadro, .ejec-bloq-barra > span,
        .ejec .kpi-cell.is-crit, .ejec-chip {
            -webkit-print-color-adjust: exact; print-color-adjust: exact;
        }
        .ejec .kpi-cell-arw { display: none; }
    }
</style>
<script>
  (function () {
    // R2: el grupo neutro llega abierto y se pliega en pantalla; al imprimir sale completo.
    var grupos = document.querySelectorAll('details.ejec-neutros');
    var antes = [];
    grupos.forEach(function (g) { g.open = false; });
    window.addEventListener('beforeprint', function () {
      antes = Array.prototype.map.call(grupos, function (g) { return g.open; });
      grupos.forEach(function (g) { g.open = true; });
    });
    window.addEventListener('afterprint', function () {
      grupos.forEach(function (g, i) { g.open = !!antes[i]; });
    });

    // Menús «Unidad o responsable» y «Proyectos»: uno abierto a la vez; se cierran al hacer clic
    // fuera o con Escape.
    var menus = document.querySelectorAll('details.ejec-sub');
    menus.forEach(function (sub) {
      sub.addEventListener('toggle', function () {
        if (sub.open) menus.forEach(function (o) { if (o !== sub) o.open = false; });
      });
      document.addEventListener('click', function (e) { if (sub.open && !sub.contains(e.target)) sub.open = false; });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sub.open) { sub.open = false; sub.querySelector('summary').focus(); } });
    });

    // «Proyectos»: buscar y marcar todos o ninguno. Solo con JS; sin él quedan las casillas.
    var panel = document.querySelector('.ejec-proy-panel');
    var herr = panel && panel.querySelector('.ejec-proy-herr');
    if (herr) {
      herr.hidden = false;
      var ops = panel.querySelectorAll('.ejec-proy-op');
      var buscar = herr.querySelector('.ejec-proy-buscar');
      var norm = function (t) { return t.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase(); };
      buscar.addEventListener('input', function () {
        var q = norm(buscar.value.trim());
        ops.forEach(function (op) { op.hidden = q !== '' && norm(op.textContent).indexOf(q) < 0; });
      });
      // Enter en el buscador no envía el formulario a medio marcar.
      buscar.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
      herr.querySelectorAll('[data-marcar]').forEach(function (b) {
        b.addEventListener('click', function () {
          var v = b.getAttribute('data-marcar') === '1';
          ops.forEach(function (op) { if (!op.hidden) op.querySelector('input').checked = v; });
        });
      });
    }
  })();
</script>
}
