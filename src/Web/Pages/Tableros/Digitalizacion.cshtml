@page
@using System.Text.Json
@model Diger.TramitesEstado.Web.Pages.Tableros.DigitalizacionModel
@{
    ViewData["Title"] = "Tablero de Digitalización";
    var d = Model.Data;
    var pctGlobal = (int)Math.Round(d.AvanceGlobalPromedio * 100);
    var J = (object o) => Html.Raw(JsonSerializer.Serialize(o));
}

<div class="container" style="max-width:1200px">
    <div class="hist-header">
        <div><h2>Tablero de Digitalización</h2><p>Seguimiento gerencial del avance de digitalización de trámites</p></div>
        <div class="btns-group">
            <a class="btns btns-primary" asp-page-handler="Excel" asp-route-institucionId="@Model.InstitucionId">⬇ Descargar Excel</a>
            <a class="btns" asp-page="/Tableros/Index">← Tableros</a>
        </div>
    </div>

    <form method="get" class="seg-filters">
        <div class="field" style="min-width:200px"><label>Institución</label>
            <select name="institucionId" onchange="this.form.submit()">
                <option value="">Todas</option>
                @foreach (var i in Model.Instituciones) { <option value="@i.Id" selected="@(Model.InstitucionId == i.Id)">@i.Nombre</option> }
            </select>
        </div>
        <a class="btns" asp-page="/Tableros/Digitalizacion" style="margin-bottom:.1rem">Limpiar</a>
    </form>

    @* ── KPI Strip ────────────────────────────────────────────────── *@
    <div class="kpi-grid" style="grid-template-columns:repeat(4, 1fr)">
        <div class="kpi-card"><div class="kpi-num">@d.TotalTramites</div><div class="kpi-lbl">Trámites en digitalización</div></div>
        <div class="kpi-card ok"><div class="kpi-num">@d.TramitesEnOperacion</div><div class="kpi-lbl">En operación</div></div>
        <div class="kpi-card"><div class="kpi-num digi-pct-hero">@pctGlobal<span style="font-size:18px">%</span></div><div class="kpi-lbl">Avance global promedio</div></div>
        <div class="kpi-card"><div class="kpi-num">@d.InstitucionesActivas</div><div class="kpi-lbl">Instituciones activas</div></div>
    </div>

    @* ── Distribución de trámites ─────────────────────────────────── *@
    <div class="dash-grid" style="grid-template-columns:1fr 1fr 1fr;margin-bottom:0">
        <div class="dash-card digi-dist-card">
            <div class="digi-dist-num ok">@d.TramitesEnOperacion</div>
            <div class="digi-dist-lbl">En operación</div>
            <div class="digi-dist-bar" style="background:#2f7d32"></div>
        </div>
        <div class="dash-card digi-dist-card">
            <div class="digi-dist-num warn">@d.TramitesEnProceso</div>
            <div class="digi-dist-lbl">En proceso</div>
            <div class="digi-dist-bar" style="background:#ef9f27"></div>
        </div>
        <div class="dash-card digi-dist-card">
            <div class="digi-dist-num muted">@d.TramitesNoIniciados</div>
            <div class="digi-dist-lbl">No iniciados</div>
            <div class="digi-dist-bar" style="background:#888780"></div>
        </div>
    </div>

    @* ── Avance por Institución ───────────────────────────────────── *@
    <div class="dash-grid" style="grid-template-columns:1fr">
        <div class="dash-card">
            <h3>Avance por institución</h3>
            @if (!d.PorInstitucion.Any())
            {
                <p style="font-size:13px;color:var(--diger-text-muted)">Sin trámites registrados.</p>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:10px;margin-top:4px">
                @foreach (var inst in d.PorInstitucion)
                {
                    var pct = (int)Math.Round(inst.AvancePromedio * 100);
                    var barColor = pct >= 100 ? "#2f7d32" : pct >= 50 ? "#1455a4" : pct >= 25 ? "#ef9f27" : "#888780";
                    <div class="digi-inst-row">
                        <span class="digi-inst-name">@inst.Institucion</span>
                        <div class="digi-inst-bar-wrap">
                            <div class="bar-track">
                                <div class="bar-fill" style="width:@(Math.Max(pct, 1))%;background:@barColor"></div>
                            </div>
                        </div>
                        <span class="digi-inst-pct" style="color:@barColor">@pct%</span>
                        <span class="digi-inst-meta">@inst.Completados/@inst.TotalTramites</span>
                    </div>
                }
                </div>
            }
        </div>
    </div>

    @* ── Distribución de avance + Etapas de la metodología ─────── *@
    <div class="dash-grid">
        <div class="dash-card">
            <h3>Distribución de avance</h3>
            <p style="font-size:11.5px;color:var(--diger-text-muted);margin:0 0 4px">Haga clic en una barra para ver los trámites de ese rango</p>
            <div style="position:relative;height:220px"><canvas id="chDist"></canvas></div>
        </div>
        <div class="dash-card" style="min-width:0">
            <h3>Avance por etapa de la metodología</h3>
            <p style="font-size:11.5px;color:var(--diger-text-muted);margin:0 0 4px">Haga clic en una barra para ver los trámites de esa etapa</p>
            <div style="position:relative;height:360px"><canvas id="chEtapas"></canvas></div>
        </div>
    </div>

    @* ── Detalle por etapa (se muestra al hacer clic en el gráfico) ─── *@
    <div id="etapa-detalle" class="dash-grid" style="grid-template-columns:1fr;display:none">
        <div class="dash-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <h3 id="etapa-detalle-titulo" style="margin:0"></h3>
                <button type="button" class="btns" onclick="cerrarDetalleEtapa()" style="font-size:12px;padding:4px 12px">✕ Cerrar</button>
            </div>
            <div id="etapa-detalle-kpis" style="display:flex;gap:16px;margin-bottom:12px"></div>
            <div style="overflow-x:auto">
            <table class="tbl" style="width:100%">
                <thead><tr>
                    <th>Institución</th>
                    <th>Trámite</th>
                    <th>Analista</th>
                    <th style="width:180px">Avance de etapa</th>
                    <th style="width:60px"></th>
                </tr></thead>
                <tbody id="etapa-detalle-body"></tbody>
            </table>
            </div>
        </div>
    </div>

    @* ── Detalle por rango de avance (se muestra al hacer clic en distribución) *@
    <div id="dist-detalle" class="dash-grid" style="grid-template-columns:1fr;display:none">
        <div class="dash-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <h3 id="dist-detalle-titulo" style="margin:0"></h3>
                <button type="button" class="btns" onclick="cerrarDetalleDist()" style="font-size:12px;padding:4px 12px">✕ Cerrar</button>
            </div>
            <div style="overflow-x:auto">
            <table class="tbl" style="width:100%">
                <thead><tr>
                    <th>Institución</th>
                    <th>Trámite</th>
                    <th>Analista</th>
                    <th style="width:180px">Avance global</th>
                    <th style="width:60px"></th>
                </tr></thead>
                <tbody id="dist-detalle-body"></tbody>
            </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<style>
    .digi-pct-hero { letter-spacing: -1px; }
    .digi-dist-card { text-align:center; padding:16px 12px 8px; }
    .digi-dist-num { font-size:32px; font-weight:800; line-height:1; }
    .digi-dist-num.ok { color:#2f7d32; }
    .digi-dist-num.warn { color:#ef9f27; }
    .digi-dist-num.muted { color:#888780; }
    .digi-dist-lbl { font-size:12px; color:var(--diger-text-muted); margin-top:4px; text-transform:uppercase; letter-spacing:.5px; }
    .digi-dist-bar { height:4px; border-radius:2px; margin-top:12px; }

    .digi-inst-row { display:grid; grid-template-columns:160px 1fr 48px 70px; align-items:center; gap:10px; }
    .digi-inst-name { font-size:13px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .digi-inst-bar-wrap { min-width:0; }
    .digi-inst-pct { font-size:14px; font-weight:800; text-align:right; }
    .digi-inst-meta { font-size:11.5px; color:var(--diger-text-muted); text-align:right; white-space:nowrap; }

    @@media (max-width: 900px) {
        .kpi-grid { grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)) !important; }
        .digi-inst-row { grid-template-columns: 100px 1fr 40px 56px; }
    }
    @@media (max-width: 600px) {
        .digi-inst-row { grid-template-columns: 1fr 48px; }
        .digi-inst-bar-wrap, .digi-inst-meta { display:none; }
    }
</style>
<script src="~/lib/chart/chart.umd.min.js" asp-append-version="true"></script>
<script>
  Chart.defaults.font.family = 'system-ui, sans-serif';
  Chart.defaults.plugins.legend.position = 'bottom';

  // Distribución de avance (barras verticales por rango)
  var distLabels = @J(d.DistribucionAvance.Select(x => x.Etiqueta));
  var distRangos = [[0, 25], [25, 50], [50, 75], [75, 101]];
  var todosTramites = @J(d.TodosLosTramites.Select(t => new { expedienteId = t.ExpedienteId, institucion = t.Institucion, tramite = t.Tramite, analista = t.Analista ?? "", pct = Math.Round(t.Avance * 100, 1) }));

  new Chart(document.getElementById('chDist'), {
    type: 'bar',
    data: {
      labels: distLabels,
      datasets: [{
        data: @J(d.DistribucionAvance.Select(x => x.Cantidad)),
        backgroundColor: ['#c4c3bc', '#ef9f27', '#1455a4', '#2f7d32'],
        borderRadius: 4,
        barThickness: 40
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false },
        tooltip: { callbacks: { label: function(ctx) { return ctx.parsed.y + ' trámites'; } } } },
      scales: { y: { beginAtZero: true, ticks: { precision: 0 } } },
      onClick: function(evt, elements) {
        if (!elements.length) return;
        mostrarDetalleDist(elements[0].index);
      }
    }
  });

  // Etapas de la metodología (barras horizontales)
  var etapaNums = @J(d.PorEtapaMetodologia.Select(e => e.EtapaNum));
  var etapaLabels = @J(d.PorEtapaMetodologia.Select(e => e.Etiqueta));
  var etapaResumen = @J(d.PorEtapaMetodologia.Select(e => new { completados = e.Completados, total = e.Total, pct = Math.Round(e.AvancePromedio * 100, 1) }));
  var detallePorEtapa = @J(d.DetallePorEtapa.Select(t => new { expedienteId = t.ExpedienteId, institucion = t.Institucion, tramite = t.Tramite, analista = t.Analista ?? "", etapaNum = t.EtapaNum, pct = Math.Round(t.AvanceEtapa * 100, 1) }));

  var chEtapas = new Chart(document.getElementById('chEtapas'), {
    type: 'bar',
    data: {
      labels: etapaNums.map(function(n, i) { return n + '. ' + (etapaLabels[i].length > 28 ? etapaLabels[i].substring(0, 28) + '…' : etapaLabels[i]); }),
      datasets: [{
        label: 'Avance promedio %',
        data: etapaResumen.map(function(e) { return e.pct; }),
        backgroundColor: etapaResumen.map(function(e) { return e.pct >= 99.99 ? '#2f7d32' : e.pct >= 50 ? '#1455a4' : e.pct > 0 ? '#ef9f27' : '#c4c3bc'; }),
        borderRadius: 4,
        barThickness: 20
      }]
    },
    options: {
      indexAxis: 'y',
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false },
        tooltip: { callbacks: { label: function(ctx) { var r = etapaResumen[ctx.dataIndex]; return r.pct + '% — ' + r.completados + '/' + r.total + ' completados'; } } } },
      scales: {
        x: { min: 0, max: 100, ticks: { callback: function(v) { return v + '%'; } } },
        y: { ticks: { font: { size: 11 } } }
      },
      onClick: function(evt, elements) {
        if (!elements.length) return;
        mostrarDetalleEtapa(elements[0].index);
      }
    }
  });

  var _etapaItems = [];
  var _etapaFiltro = 'proceso';

  function clasificar(t) { return t.pct >= 99.99 ? 'ok' : t.pct > 0 ? 'proceso' : 'cero'; }

  function mostrarDetalleEtapa(idx) {
    var num = etapaNums[idx];
    var label = etapaLabels[idx];
    _etapaItems = detallePorEtapa.filter(function(t) { return t.etapaNum === num; });
    _etapaItems.sort(function(a, b) { return a.pct - b.pct; });

    document.getElementById('etapa-detalle-titulo').textContent = 'Etapa ' + num + ' — ' + label;

    var cOk = _etapaItems.filter(function(t) { return clasificar(t) === 'ok'; }).length;
    var cProc = _etapaItems.filter(function(t) { return clasificar(t) === 'proceso'; }).length;
    var cCero = _etapaItems.filter(function(t) { return clasificar(t) === 'cero'; }).length;

    document.getElementById('etapa-detalle-kpis').innerHTML =
      kpiBadge('todos', _etapaItems.length, 'Todos', '#0a2d6e', '#e8edf5') +
      kpiBadge('ok', cOk, 'Completados', '#2f7d32', '#e8f5e9') +
      kpiBadge('proceso', cProc, 'En proceso', '#ef9f27', '#fff3e0') +
      kpiBadge('cero', cCero, 'No iniciados', '#888780', '#f5f5f4');

    _etapaFiltro = cProc > 0 ? 'proceso' : cCero > 0 ? 'cero' : 'todos';
    renderTablaEtapa();

    var panel = document.getElementById('etapa-detalle');
    panel.style.display = '';
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function kpiBadge(filtro, n, label, fg, bg) {
    return '<button type="button" onclick="filtrarEtapa(\'' + filtro + '\')" ' +
      'class="etapa-kpi-btn" data-filtro="' + filtro + '" ' +
      'style="font-size:13px;padding:4px 12px;border-radius:12px;border:2px solid transparent;' +
      'background:' + bg + ';color:' + fg + ';font-weight:700;cursor:pointer">' +
      n + ' ' + label + '</button>';
  }

  function filtrarEtapa(filtro) {
    _etapaFiltro = filtro;
    renderTablaEtapa();
  }

  function renderTablaEtapa() {
    var filtered = _etapaFiltro === 'todos' ? _etapaItems :
      _etapaItems.filter(function(t) { return clasificar(t) === _etapaFiltro; });

    document.querySelectorAll('.etapa-kpi-btn').forEach(function(btn) {
      btn.style.borderColor = btn.getAttribute('data-filtro') === _etapaFiltro ? btn.style.color : 'transparent';
    });

    if (!filtered.length) {
      document.getElementById('etapa-detalle-body').innerHTML =
        '<tr><td colspan="5" style="text-align:center;color:var(--diger-text-muted);padding:24px">Sin trámites en esta categoría</td></tr>';
      return;
    }
    var html = '';
    filtered.forEach(function(t) {
      var barColor = t.pct >= 99.99 ? '#2f7d32' : t.pct >= 50 ? '#1455a4' : t.pct > 0 ? '#ef9f27' : '#888780';
      html += '<tr>' +
        '<td>' + esc(t.institucion) + '</td>' +
        '<td style="font-weight:600;color:#0a2d6e">' + esc(t.tramite) + '</td>' +
        '<td style="font-size:12px;color:var(--diger-text-muted)">' + (t.analista || '—') + '</td>' +
        '<td><div style="display:flex;align-items:center;gap:8px">' +
          '<div class="bar-track" style="flex:1"><div class="bar-fill" style="width:' + Math.max(t.pct, 1) + '%;background:' + barColor + '"></div></div>' +
          '<span style="font-size:12px;font-weight:700;min-width:36px;text-align:right;color:' + barColor + '">' + t.pct + '%</span>' +
        '</div></td>' +
        '<td style="text-align:right"><a class="btns" href="/Expedientes/Editor/' + t.expedienteId + '" style="font-size:11.5px;padding:4px 10px">Ver</a></td>' +
        '</tr>';
    });
    document.getElementById('etapa-detalle-body').innerHTML = html;
  }

  function cerrarDetalleEtapa() {
    document.getElementById('etapa-detalle').style.display = 'none';
  }

  function mostrarDetalleDist(idx) {
    var rango = distRangos[idx];
    var label = distLabels[idx];
    var items = todosTramites.filter(function(t) {
      return t.pct >= rango[0] && t.pct < rango[1];
    });
    items.sort(function(a, b) { return a.pct - b.pct; });

    document.getElementById('dist-detalle-titulo').textContent = 'Trámites con avance ' + label + ' (' + items.length + ')';

    if (!items.length) {
      document.getElementById('dist-detalle-body').innerHTML =
        '<tr><td colspan="5" style="text-align:center;color:var(--diger-text-muted);padding:24px">Sin trámites en este rango</td></tr>';
    } else {
      var html = '';
      items.forEach(function(t) {
        var barColor = t.pct >= 99.99 ? '#2f7d32' : t.pct >= 50 ? '#1455a4' : t.pct > 0 ? '#ef9f27' : '#888780';
        html += '<tr>' +
          '<td>' + esc(t.institucion) + '</td>' +
          '<td style="font-weight:600;color:#0a2d6e">' + esc(t.tramite) + '</td>' +
          '<td style="font-size:12px;color:var(--diger-text-muted)">' + (t.analista || '—') + '</td>' +
          '<td><div style="display:flex;align-items:center;gap:8px">' +
            '<div class="bar-track" style="flex:1"><div class="bar-fill" style="width:' + Math.max(t.pct, 1) + '%;background:' + barColor + '"></div></div>' +
            '<span style="font-size:12px;font-weight:700;min-width:36px;text-align:right;color:' + barColor + '">' + t.pct + '%</span>' +
          '</div></td>' +
          '<td style="text-align:right"><a class="btns" href="/Expedientes/Editor/' + t.expedienteId + '" style="font-size:11.5px;padding:4px 10px">Ver</a></td>' +
          '</tr>';
      });
      document.getElementById('dist-detalle-body').innerHTML = html;
    }

    var panel = document.getElementById('dist-detalle');
    panel.style.display = '';
    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function cerrarDetalleDist() {
    document.getElementById('dist-detalle').style.display = 'none';
  }

  function esc(s) {
    var d = document.createElement('div'); d.textContent = s; return d.innerHTML;
  }
</script>
}
