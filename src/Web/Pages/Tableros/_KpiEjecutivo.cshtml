@using Diger.TramitesEstado.Application.Dashboards.Queries.GetEjecutivoProyectos
@model EjecutivoProyectosDto
@*
    Los cinco KPI del tablero ejecutivo de proyectos (especificación §2.1). Lo usan el propio
    tablero y la banda del Inicio, con la misma consulta: el resumen no puede decir otra cosa
    que el tablero al que lleva. ViewData["DestinoKpi"] es la página a la que apuntan las celdas
    enlazables; vacío = anclas dentro de la misma página.
*@
@{
    var d = Model;
    var destino = ViewData["DestinoKpi"] as string ?? "";
    int Pct(int parte) => d.Total == 0 ? 0 : (int)Math.Round(parte * 100.0 / d.Total, MidpointRounding.AwayFromZero);
    string Tono(int v) => v == 0 ? "is-zero" : "";

    // Color del número de desviación: mismas constantes que el semáforo de cada proyecto.
    string? ColorDesv = d.Desviacion switch
    {
        null => null,
        var x when x <= ProyectoEstadoReglas.DesviacionRoja  => "var(--diger-danger-text)",
        var x when x <= ProyectoEstadoReglas.DesviacionAmbar => "var(--diger-warning-strong)",
        _ => "var(--diger-success-strong)"
    };
}
<div class="kpi-strip ejec-kpis" style="--kpi-cols:5">
    <div class="kpi-cell @Tono(d.Total)">
        <div class="kpi-cell-top">
            <span class="kpi-cell-ico"><svg class="ico"><use href="#i-plan"></use></svg></span>
            <span class="kpi-cell-lbl">Proyectos</span>
        </div>
        <div class="kpi-cell-num">@d.Total</div>
        <div class="kpi-cell-sub">@d.Finalizados finalizados · @d.EnProceso en proceso · @d.NoIniciados no iniciados</div>
    </div>

    <div class="kpi-cell @Tono(d.Finalizados)">
        <div class="kpi-cell-top">
            <span class="kpi-cell-ico"><svg class="ico"><use href="#i-check"></use></svg></span>
            <span class="kpi-cell-lbl">Finalizados</span>
        </div>
        <div class="kpi-cell-num">@d.Finalizados</div>
        <div class="kpi-cell-sub">@Pct(d.Finalizados)&#8239;% del total</div>
    </div>

    <a class="kpi-cell @Tono(d.EnProceso)" href="@(destino)#ejec-lista">
        <div class="kpi-cell-top">
            <span class="kpi-cell-ico"><svg class="ico"><use href="#i-grafica"></use></svg></span>
            <span class="kpi-cell-lbl">En proceso</span>
            <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
        </div>
        <div class="kpi-cell-num">@d.EnProceso</div>
        <div class="kpi-cell-sub">@Pct(d.EnProceso)&#8239;% del total · @d.EnProcesoEnRojo en rojo</div>
    </a>

    @* K4 (Revisión 1, R1): el número grande es el real de los proyectos con estructura; la
       comparación contra el plan va en las líneas de abajo y SOLO sobre los que tienen línea base,
       con real y esperado de esa misma subpoblación. Nunca dos cifras de poblaciones distintas
       lado a lado: 53 contra 99 se lee como −46 cuando la desviación es −30.6. *@
    <div class="kpi-cell @(d.ConEstructura == 0 ? "is-zero" : "")">
        <div class="kpi-cell-top">
            <span class="kpi-cell-ico"><svg class="ico"><use href="#i-estado"></use></svg></span>
            <span class="kpi-cell-lbl">Avance real</span>
        </div>
        <div class="kpi-cell-num ejec-kpi-avance">@FormatoEjecutivo.Decimal1(d.AvanceReal)<small>&#8239;%</small></div>
        @if (d.Desviacion is { } desv && d.AvanceEsperado is { } esp && d.AvanceRealConLineaBase is { } realLb)
        {
            <div class="kpi-cell-sub ejec-kpi-desv"><strong style="color:@ColorDesv">@FormatoEjecutivo.Puntos(desv) vs esperado</strong></div>
            <div class="kpi-cell-sub ejec-kpi-sub">@d.ConLineaBase con plan: @FormatoEjecutivo.Decimal1(realLb)&#8239;% real · @FormatoEjecutivo.Decimal1(esp)&#8239;% esperado</div>
        }
        else
        {
            <div class="kpi-cell-sub ejec-kpi-sub">sin línea base en la cartera</div>
        }
    </div>

    <a class="kpi-cell @(d.BloqueosVigentes > 0 ? "is-crit" : "is-zero")" href="@(destino)#ejec-decisiones">
        <div class="kpi-cell-top">
            <span class="kpi-cell-ico"><svg class="ico"><use href="#i-alerta"></use></svg></span>
            <span class="kpi-cell-lbl">Bloqueos vigentes</span>
            <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
        </div>
        <div class="kpi-cell-num">@d.BloqueosVigentes</div>
        <div class="kpi-cell-sub">
            @if (d.DiasBloqueoMasAntiguo is { } dias)
            {<text>el más antiguo @FormatoEjecutivo.Hace(dias)</text>}
            else
            {<svg class="ico"><use href="#i-check"></use></svg><text>ninguno</text>}
        </div>
    </a>
</div>
