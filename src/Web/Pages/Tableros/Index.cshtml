@page
@using System.Text.Json
@model Diger.TramitesEstado.Web.Pages.Tableros.IndexModel
@{
    ViewData["Title"] = "Tableros";
    var d = Model.Data;
    (string bg, string fg) EstadoColor(EstadoTicket e) => e switch
    {
        EstadoTicket.Abierto => ("#e6f1fb", "#0c447c"), EstadoTicket.EnProgreso => ("#faeeda", "#854f0b"),
        EstadoTicket.Resuelto => ("#eaf3de", "#27500a"), _ => ("#f1efe8", "#444441"),
    };
    string EstadoLbl(EstadoTicket e) => e == EstadoTicket.EnProgreso ? "En progreso" : e.ToString();

    // La tira apaga los ceros: un cero es una confirmación, no un dato que compita
    // por atención con los valores que sí exigen acción.
    string Tono(int valor, string tonoActivo) => valor == 0 ? "is-zero" : tonoActivo;

    var hayTicketsEnGrafica = d.TicketsPorMes.Any(x => x.Cantidad > 0);
}

<div class="container" style="max-width:1100px">
    <div class="hist-header">
        <div>
            <h2>Tableros</h2>
            <p>Resumen del portal — métricas de su alcance</p>
        </div>
    </div>

    <div class="kpi-strip">
        <div class="kpi-cell @Tono(d.TicketsCriticos, "is-crit")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-alerta"></use></svg></span>
                <span class="kpi-cell-lbl">Tickets críticos</span>
            </div>
            <div class="kpi-cell-num">@d.TicketsCriticos</div>
            <div class="kpi-cell-sub">
                @if (d.TicketsCriticos == 0)
                {
                    <svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>
                }
                else
                {
                    <text>Requiere atención</text>
                }
            </div>
        </div>

        <div class="kpi-cell @Tono(d.TicketsAbiertos, "is-warn")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-ticket"></use></svg></span>
                <span class="kpi-cell-lbl">Tickets abiertos</span>
            </div>
            <div class="kpi-cell-num">@d.TicketsAbiertos</div>
            <div class="kpi-cell-sub">
                @if (d.TicketsAbiertos == 0)
                {
                    <svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>
                }
                else
                {
                    <text>de @d.TicketsTotal en total</text>
                }
            </div>
        </div>

        <div class="kpi-cell @Tono(d.TicketsEnProgreso, "")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-reloj"></use></svg></span>
                <span class="kpi-cell-lbl">En progreso</span>
            </div>
            <div class="kpi-cell-num">@d.TicketsEnProgreso</div>
            <div class="kpi-cell-sub">
                @if (d.TicketsEnProgreso == 0)
                {
                    <svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>
                }
                else
                {
                    <text>en atención</text>
                }
            </div>
        </div>

        <a class="kpi-cell @Tono(d.AcuerdosVencidos, "is-crit")" asp-page="/Reuniones/Compromisos" asp-route-soloVencidos="true">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-vencido"></use></svg></span>
                <span class="kpi-cell-lbl">Acuerdos vencidos</span>
                <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </div>
            <div class="kpi-cell-num">@d.AcuerdosVencidos</div>
            <div class="kpi-cell-sub">
                @if (d.AcuerdosVencidos == 0)
                {
                    <svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>
                }
                else
                {
                    <text>Requiere atención</text>
                }
            </div>
        </a>

        <a class="kpi-cell @Tono(d.AcuerdosProximos, "is-warn")" asp-page="/Reuniones/Compromisos">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-calendario"></use></svg></span>
                <span class="kpi-cell-lbl">Acuerdos próximos</span>
                <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </div>
            <div class="kpi-cell-num">@d.AcuerdosProximos</div>
            <div class="kpi-cell-sub">
                @if (d.AcuerdosProximos == 0)
                {
                    <svg class="ico"><use href="#i-check"></use></svg><text>Sin vencimientos</text>
                }
                else
                {
                    <text>por vencer</text>
                }
            </div>
        </a>

        <div class="kpi-cell @Tono(d.ExpedientesCerrados, "is-ok")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-expediente-ok"></use></svg></span>
                <span class="kpi-cell-lbl">Exp. cerrados</span>
            </div>
            <div class="kpi-cell-num">@d.ExpedientesCerrados</div>
            <div class="kpi-cell-sub">de @d.ExpedientesTotal en total</div>
        </div>
    </div>

    <div class="dash-card" style="margin-bottom:16px">
        <h3>
            Tickets creados por mes (12 meses)
            @if (hayTicketsEnGrafica)
            {
                var tt = d.TicketsCreados;
                var fl = tt.Delta > 0 ? "▲" : tt.Delta < 0 ? "▼" : "▬";
                var tc = tt.Delta > 0 ? "#a32d2d" : tt.Delta < 0 ? "#0f6e56" : "#6b7fa3";
                <span style="font-size:13px;color:@tc;font-weight:700;margin-left:6px">@fl @Math.Abs(tt.PorcentajeCambio)% vs mes anterior</span>
            }
        </h3>
        @if (hayTicketsEnGrafica)
        {
            <div style="position:relative;height:200px"><canvas id="chResumen"></canvas></div>
        }
        else
        {
            @* Una línea plana en cero con "0% vs mes anterior" se lee como
               componente roto; mejor decir explícitamente que no hay datos. *@
            <div class="empty-state">
                <div class="empty-state-ico"><svg class="ico"><use href="#i-grafica"></use></svg></div>
                <div class="empty-state-t1">Sin tickets creados en los últimos 12 meses</div>
                <div class="empty-state-t2">La tendencia aparecerá cuando se registre el primer ticket</div>
            </div>
        }
    </div>

    <div class="dash-grid">
        <div class="dash-card">
            <h3>Atajos a tableros</h3>
            <a class="nav-item" asp-page="/Tableros/Tickets">
                <span class="nav-item-ico"><svg class="ico"><use href="#i-ticket"></use></svg></span>
                <span class="nav-item-tx">
                    <span class="nav-item-t1">Tickets de soporte</span>
                    <span class="nav-item-t2">@(d.TicketsAbiertos > 0 ? $"{d.TicketsAbiertos} abiertos" : "Sin actividad pendiente")</span>
                </span>
                <span class="nav-item-ct">@d.TicketsTotal</span>
                <span class="nav-item-chev"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </a>
            <div class="nav-sep"></div>
            <a class="nav-item" asp-page="/Tableros/Expedientes">
                <span class="nav-item-ico"><svg class="ico"><use href="#i-expediente"></use></svg></span>
                <span class="nav-item-tx">
                    <span class="nav-item-t1">Expedientes</span>
                    <span class="nav-item-t2">Digitalización · @d.ExpedientesEnProceso en proceso</span>
                </span>
                <span class="nav-item-ct">@d.ExpedientesTotal</span>
                <span class="nav-item-chev"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </a>
            <div class="nav-sep"></div>
            <a class="nav-item" asp-page="/Tableros/Tramites">
                <span class="nav-item-ico"><svg class="ico"><use href="#i-grafica"></use></svg></span>
                <span class="nav-item-tx">
                    <span class="nav-item-t1">Avance de trámites</span>
                    <span class="nav-item-t2">Semáforo de seguimiento por trámite</span>
                </span>
                <span class="nav-item-chev"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </a>
            <div class="nav-sep"></div>
            <a class="nav-item" asp-page="/Tableros/Reuniones">
                <span class="nav-item-ico"><svg class="ico"><use href="#i-calendario"></use></svg></span>
                <span class="nav-item-tx">
                    <span class="nav-item-t1">Reuniones y acuerdos</span>
                    <span class="nav-item-t2">@d.ReunionesMes este mes</span>
                </span>
                <span class="nav-item-ct">@d.ReunionesTotal</span>
                <span class="nav-item-chev"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </a>
            <div class="nav-sep"></div>
            <a class="nav-item" asp-page="/Tableros/Digitalizacion">
                <span class="nav-item-ico"><svg class="ico"><use href="#i-grafica"></use></svg></span>
                <span class="nav-item-tx">
                    <span class="nav-item-t1">Digitalización</span>
                    <span class="nav-item-t2">Avance de la metodología por institución</span>
                </span>
                <span class="nav-item-chev"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </a>
        </div>

        <div class="dash-card">
            <h3>Últimos tickets</h3>
            @if (!d.UltimosTickets.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-ico"><svg class="ico"><use href="#i-ticket"></use></svg></div>
                    <div class="empty-state-t1">No hay tickets en su alcance</div>
                    <div class="empty-state-t2">Los tickets de sus instituciones aparecerán aquí</div>
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:7px">
                    @foreach (var t in d.UltimosTickets)
                    {
                        var ec = EstadoColor(t.Estado);
                        <a asp-page="/Tickets/Detalle" asp-route-id="@t.Id" style="text-decoration:none;display:flex;align-items:center;gap:8px;font-size:13px">
                            <span class="res-meta" style="font-variant-numeric:tabular-nums">@t.Numero</span>
                            <span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#1c2333">@t.Titulo</span>
                            <span style="background:@ec.bg;color:@ec.fg;border-radius:20px;padding:1px 9px;font-size:11px;font-weight:700">@EstadoLbl(t.Estado)</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
@if (hayTicketsEnGrafica)
{
<script src="~/lib/chart/chart.umd.min.js" asp-append-version="true"></script>
<script>
  Chart.defaults.font.family = 'system-ui, sans-serif';
  new Chart(document.getElementById('chResumen'), {
    type: 'line',
    data: { labels: @Html.Raw(JsonSerializer.Serialize(d.TicketsPorMes.Select(x => x.Mes))),
      datasets: [{ label: 'Tickets', data: @Html.Raw(JsonSerializer.Serialize(d.TicketsPorMes.Select(x => x.Cantidad))),
        borderColor: '#1455a4', backgroundColor: 'rgba(20,85,164,.12)', fill: true, tension: .3 }] },
    options: { responsive: true, maintainAspectRatio: false, plugins:{legend:{display:false}}, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
  });
</script>
}
}
