@page
@using System.Text.Json
@inject AccesoModulosService Acceso
@model Diger.TramitesEstado.Web.Pages.Tableros.IndexModel
@{
    ViewData["Title"] = "Tableros";
    // Las celdas enlazables del resumen ejecutivo apuntan al tablero, no a anclas de esta página.
    ViewData["DestinoKpi"] = "/Tableros/Ejecutivo";
    var d = Model.Data;
    var ej = Model.Ejecutivo;
    var J = (object o) => Html.Raw(JsonSerializer.Serialize(o));
    string Tono(int valor, string tonoActivo) => valor == 0 ? "is-zero" : tonoActivo;
    var hayTickets = d.TicketsPorMes.Any(x => x.Cantidad > 0) || d.TicketsResueltosPorMes.Any(x => x.Cantidad > 0);
    var puedeDigitalizacion = await Acceso.PuedeClaveAsync("Expedientes.Ver");
}

@* Esta página es el destino del login, así que solo lleva lo que vale para
   cualquier unidad: tickets, acuerdos de reunión, cumplimiento y capacitación.
   El avance de digitalización de trámites salió de acá — era un resumen de un
   solo dominio presentado como si fuera el del portal — y vive en sus propios
   tableros (/Tableros/Digitalizacion y /Tableros/Tramites), bajo la clave de
   ese dominio. Si vuelve a hacer falta un indicador acá, que sea uno que toda
   unidad pueda leer como suyo. *@
<div class="container" style="max-width:1200px">
    <div class="hist-header">
        <div>
            <h2>Tableros</h2>
            <p>Resumen ejecutivo, lo que pide atención hoy y todos los tableros del portal</p>
        </div>
    </div>

    @* ── A. Resumen del tablero ejecutivo de proyectos ────────────────
       Solo con Proyectos.Ver (el modelo ni lo calcula sin ella). Es un resumen y no el tablero
       entero: el Inicio es el destino del login de todos los roles, y quien sí ve proyectos
       necesita el tablero en su propia ruta para proyectarlo e imprimirlo. *@
    @if (ej is not null)
    {
        var nuevo = TablerosCatalogo.Buscar("/Tableros/Ejecutivo");
        <section class="ini-banda" aria-labelledby="ini-ejec-t">
            <div class="ini-banda-cab">
                <h3 id="ini-ejec-t">Tablero ejecutivo de proyectos<span class="ini-banda-sub">@Model.EjecutivoTitulo</span></h3>
                @if (nuevo is not null && TablerosCatalogo.TextoInsignia(nuevo) is { } txtNuevo)
                {
                    <span class="@TablerosCatalogo.ClaseInsignia(nuevo.Estado)"><svg class="ico" aria-hidden="true"><use href="#@TablerosCatalogo.IconoInsignia(nuevo.Estado)"></use></svg>@txtNuevo</span>
                }
            </div>
            <partial name="_KpiEjecutivo" model="ej" />
            <div class="ini-banda-pie">
                <span class="res-meta">
                    @if (ej.Decisiones.Count == 0)
                    {<text>Ningún asunto espera una decisión</text>}
                    else
                    {<text>@ej.Decisiones.Count @(ej.Decisiones.Count == 1 ? "asunto necesita" : "asuntos necesitan") decisión</text>}
                </span>
                <a class="btnp" asp-page="/Tableros/Ejecutivo">Abrir tablero ejecutivo →</a>
            </div>
        </section>
    }

    @* ── B. Atención hoy: indicadores comunes a todas las unidades ──── *@
    <section class="ini-banda" aria-labelledby="ini-hoy-t">
    <div class="ini-banda-cab">
        <h3 id="ini-hoy-t">Atención hoy <span class="help-tip tip-down" data-tip="Tickets de soporte, acuerdos de reunión, cumplimiento y personas capacitadas. Los valores en rojo requieren atención inmediata.">?</span></h3>
    </div>
    <div class="kpi-strip" style="--kpi-cols:5">
        <a class="kpi-cell @Tono(d.TicketsCriticos, "is-crit")" asp-page="/Tableros/Tickets">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-alerta"></use></svg></span>
                <span class="kpi-cell-lbl">Tickets críticos</span>
                <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </div>
            <div class="kpi-cell-num">@d.TicketsCriticos</div>
            <div class="kpi-cell-sub">
                @if (d.TicketsCriticos == 0)
                {<svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>}
                else
                {<text>Requiere atención</text>}
            </div>
        </a>

        <a class="kpi-cell @Tono(d.AcuerdosVencidos, "is-crit")" asp-page="/Reuniones/Compromisos" asp-route-soloVencidos="true">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-vencido"></use></svg></span>
                <span class="kpi-cell-lbl">Acuerdos vencidos</span>
                <span class="kpi-cell-arw"><svg class="ico"><use href="#i-chevron"></use></svg></span>
            </div>
            <div class="kpi-cell-num">@d.AcuerdosVencidos</div>
            <div class="kpi-cell-sub">
                @if (d.AcuerdosVencidos == 0)
                {<svg class="ico"><use href="#i-check"></use></svg><text>Sin pendientes</text>}
                else
                {<text>Requiere atención</text>}
            </div>
        </a>

        <div class="kpi-cell @Tono(d.TasaCumplimiento, "is-ok")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-check"></use></svg></span>
                <span class="kpi-cell-lbl">Cumplimiento</span>
            </div>
            <div class="kpi-cell-num">@d.TasaCumplimiento<span style="font-size:16px">%</span></div>
            <div class="kpi-cell-sub">@d.AcuerdosCumplidos de @d.AcuerdosTotal acuerdos</div>
        </div>

        <div class="kpi-cell @Tono(d.PersonasCapacitadas, "")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-reunion"></use></svg></span>
                <span class="kpi-cell-lbl">Personas capacitadas</span>
            </div>
            <div class="kpi-cell-num">@d.PersonasCapacitadas</div>
            <div class="kpi-cell-sub">@d.AsistenciasCapacitacion asistencias registradas</div>
        </div>

        <div class="kpi-cell @Tono(d.TicketsResueltos, "is-ok")">
            <div class="kpi-cell-top">
                <span class="kpi-cell-ico"><svg class="ico"><use href="#i-ticket"></use></svg></span>
                <span class="kpi-cell-lbl">Tickets resueltos</span>
            </div>
            <div class="kpi-cell-num">@d.TicketsResueltos</div>
            <div class="kpi-cell-sub">
                @if (d.TicketsDiasPromedioResolucion > 0)
                {<text>~@d.TicketsDiasPromedioResolucion días promedio</text>}
                else
                {<text>de @d.TicketsTotal en total</text>}
            </div>
        </div>
    </div>

    </section>

    @* ── C. Todos los tableros ────────────────────────────────────────
       Sale del catálogo (Web/Common/TablerosCatalogo.cs): una tarjeta por tablero que el usuario
       puede abrir, gateada con las claves de su DESTINO, y la insignia de la auditoría con texto,
       icono y color — nunca solo color. *@
    <section class="ini-banda" aria-labelledby="ini-todos-t">
        <div class="ini-banda-cab"><h3 id="ini-todos-t">Todos los tableros</h3></div>
        <div class="cat-tableros">
            @foreach (var t in Model.Tableros)
            {
                var insignia = TablerosCatalogo.TextoInsignia(t);
                <a class="cat-tablero" href="@t.Ruta">
                    <span class="cat-tablero-ico"><svg class="ico" aria-hidden="true"><use href="#@t.Icono"></use></svg></span>
                    <span>
                        <span class="cat-tablero-t1">@t.Titulo</span>
                        <span class="cat-tablero-t2">@t.Descripcion</span>
                        @if (insignia is not null)
                        {
                            <span class="@TablerosCatalogo.ClaseInsignia(t.Estado)"><svg class="ico" aria-hidden="true"><use href="#@TablerosCatalogo.IconoInsignia(t.Estado)"></use></svg>@insignia</span>
                        }
                    </span>
                </a>
            }
        </div>
    </section>

    @* ── D. Indicadores operativos ────────────────────────────────────
       Lo que el Inicio mostraba antes, sin cambios de contenido: se movió abajo para que el
       índice de tableros quede a la vista. El detalle vive en /Tableros/Tickets y /Tableros/Reuniones. *@
    <section class="ini-banda" aria-labelledby="ini-oper-t">
        <div class="ini-banda-cab"><h3 id="ini-oper-t">Indicadores operativos</h3></div>
    @* ── Tendencia de tickets ─────────────────────────────────────── *@
    <div class="dash-grid">
        <div class="dash-card">
            <h3>
                Tickets — creados vs resueltos (12 meses)
                @if (hayTickets)
                {
                    var tt = d.TicketsCreados;
                    var fl = tt.Delta > 0 ? "▲" : tt.Delta < 0 ? "▼" : "▬";
                    var tc = tt.Delta > 0 ? "var(--diger-danger-strong)" : tt.Delta < 0 ? "#0f6e56" : "var(--diger-text-muted)";
                    <span style="font-size:12px;color:@tc;font-weight:700;margin-left:6px">@fl @Math.Abs(tt.PorcentajeCambio)% vs mes anterior</span>
                }
            </h3>
            @if (hayTickets)
            {
                <div style="position:relative;height:220px"><canvas id="chTickets"></canvas></div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-state-ico"><svg class="ico"><use href="#i-grafica"></use></svg></div>
                    <div class="empty-state-t1">Sin tickets en los últimos 12 meses</div>
                    <div class="empty-state-t2">La tendencia aparecerá cuando se registre el primer ticket</div>
                </div>
            }
        </div>
    </div>

    @* ── Indicadores operativos resumidos ──────────────────────────── *@
    <div class="kpi-grid" style="grid-template-columns:repeat(3, 1fr)">
        <div class="kpi-card">
            <div class="kpi-num">@d.TicketsAbiertos</div>
            <div class="kpi-lbl">Tickets abiertos</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-num">@d.ReunionesTotal</div>
            <div class="kpi-lbl">Reuniones</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-num">@d.ReunionesMes</div>
            <div class="kpi-lbl">Reuniones este mes</div>
        </div>
    </div>

    </section>
</div>

@section Scripts {
@if (hayTickets)
{
<script src="~/lib/chart/chart.umd.min.js" asp-append-version="true"></script>
<script>
  Chart.defaults.font.family = 'system-ui, sans-serif';
  new Chart(document.getElementById('chTickets'), {
    type: 'line',
    data: {
      labels: @J(d.TicketsPorMes.Select(x => x.Mes)),
      datasets: [
        {
          label: 'Creados',
          data: @J(d.TicketsPorMes.Select(x => x.Cantidad)),
          borderColor: '#1a65a3',
          backgroundColor: 'rgba(26,101,163,.08)',
          fill: true,
          tension: .3
        },
        {
          label: 'Resueltos',
          data: @J(d.TicketsResueltosPorMes.Select(x => x.Cantidad)),
          borderColor: '#2f7d32',
          backgroundColor: 'rgba(47,125,50,.08)',
          fill: true,
          tension: .3
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, padding: 16 } } },
      scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
    }
  });
</script>
}
}
