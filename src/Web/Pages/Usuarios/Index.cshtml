@page
@model Diger.TramitesEstado.Web.Pages.Usuarios.IndexModel
@inject Diger.TramitesEstado.Application.Common.Interfaces.IRolCatalogo RolCatalogo
@inject AccesoModulosService Acceso
@{
    ViewData["Title"] = "Usuarios";

    // El color del badge lo define el rol en /Accesos/Roles. La tabla de abajo queda solo
    // como respaldo para los roles base que aún no tengan color asignado y para códigos que
    // ya no estén en el catálogo (usuarios con un rol desactivado o eliminado).
    (string bg, string fg) RolColorPorDefecto(string r) => r switch
    {
        "Administrador"   => ("#eeedfe", "#3c3489"),
        "JefeInstitucion" => ("#e6f1fb", "#0c447c"),
        "JefeArea"        => ("#e6f1fb", "#1a5fa0"),
        "JefeUnidad"      => ("#e8f5e9", "#1b5e20"),
        "Consultor"       => ("#fff8e1", "#6d4c00"),
        _                 => ("#e1f5ee", "#085041"),
    };
}

<div class="container" style="max-width:920px">
    <partial name="_SuccessBanner" />
    <div class="hist-header">
        <div>
            <h2>Usuarios</h2>
            <p>Gestión de usuarios internos del portal DIGER</p>
        </div>
        @* Esta página pide Usuarios.Ver; el editor pide Usuarios.Editar. Sin este gateo, un
           rol de solo consulta veía el botón y caía en Forbidden al usarlo. *@
        @if (await Acceso.PuedeEditarAsync("Usuarios"))
        {
            <a class="btnp" asp-page="/Usuarios/Editor">+ Nuevo usuario</a>
        }
    </div>

    <form method="get" class="lista-buscar">
        <input type="search" name="q" value="@Model.Q" placeholder="Buscar por nombre o correo…" />
        <button class="btns" type="submit">Buscar</button>
        @if (!string.IsNullOrEmpty(Model.Q)) { <a class="btns" asp-page="/Usuarios/Index">Limpiar</a> }
        @* Solo para el administrador: es el único que elimina y restaura, y para el resto los
           eliminados sencillamente no existen. Sin esta casilla, un borrado por error solo se
           desharía tocando la base de datos. *@
        @if (Model.PuedeEliminar)
        {
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;margin-left:auto">
                <input type="checkbox" name="eliminados" value="true" checked="@Model.VerEliminados"
                       onchange="this.form.submit()" style="width:auto;margin:0" />
                <span>Mostrar eliminados</span>
            </label>
        }
    </form>

    <table class="seg-table">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Rol</th>
                <th>Estado</th>
                <th style="width:1%"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model.Resultado.Items)
            {
                <tr style="@(u.Eliminado ? "opacity:.55" : "")">
                    <td>
                        @if (u.Eliminado)
                        {
                            @* Sin enlace al editor: el filtro global lo esconde y la página daría
                               «no encontrado». Primero se restaura, después se edita. *@
                            <span>@u.Nombre</span>
                            <span class="badge badge-secondary" style="margin-left:6px">Eliminado</span>
                        }
                        else
                        {
                            <a class="seg-inst" asp-page="/Usuarios/Editor" asp-route-id="@u.Id">@u.Nombre</a>
                        }
                    </td>
                    <td class="res-meta">@u.Correo</td>
                    <td>
                        @{
                            var info = RolCatalogo.Obtener(u.Rol);
                            var (bg, fg) = string.IsNullOrWhiteSpace(info?.Color)
                                ? RolColorPorDefecto(u.Rol)
                                : (info!.Color!, "#fff");
                        }
                        <span class="rol-badge" style="padding:2px 10px;font-size:12px;background:@bg;color:@fg" title="@u.Rol">@(info?.Nombre ?? u.Rol)</span>
                    </td>
                    <td>
                        @if (u.Activo)
                        {
                            <span style="color:#0f6e56;font-size:13px;font-weight:600">● Activo</span>
                        }
                        else
                        {
                            <span style="color:#94a3b8;font-size:13px;font-weight:600">○ Inactivo</span>
                        }
                    </td>
                    <td style="text-align:right;white-space:nowrap">
                        @* Un formulario POR FILA, con el handler en su propio action.
                           No se puede colgar el handler del botón: diger.js intercepta el submit de
                           cualquier .hist-del, muestra su modal y reenvía con form.submit(), que usa
                           el action del FORMULARIO y descarta el formaction del botón. Con el handler
                           solo en el botón, el POST caía en /Usuarios sin ?handler=, Razor Pages no
                           encontraba handler y renderizaba la página sin ejecutar nada: la lista salía
                           vacía y no se borraba a nadie. *@
                        @if (u.Eliminado)
                        {
                            <form method="post" asp-page-handler="Restaurar" style="display:inline">
                                <input type="hidden" name="id" value="@u.Id" />
                                <input type="hidden" name="q" value="@Model.Q" />
                                <button type="submit" class="btns"
                                        style="font-size:12.5px;padding:6px 12px">Restaurar</button>
                            </form>
                        }
                        else
                        {
                            <a class="btns" asp-page="/Usuarios/Editor" asp-route-id="@u.Id"
                               style="font-size:12.5px;padding:6px 12px">Editar</a>
                            @if (Model.PuedeEliminar)
                            {
                                <form method="post" asp-page-handler="Eliminar" style="display:inline">
                                    <input type="hidden" name="id" value="@u.Id" />
                                    <input type="hidden" name="q" value="@Model.Q" />
                                    <input type="hidden" name="eliminados" value="@Model.VerEliminados.ToString().ToLowerInvariant()" />
                                    @* data-confirm y no onclick: el modal ya lo pone diger.js al ver
                                       .hist-del. Con un confirm() propio encima salían DOS diálogos
                                       seguidos para la misma acción. *@
                                    <button type="submit" class="hist-del"
                                            data-confirm="¿Eliminar a @u.Nombre? Dejará de aparecer en el portal y no podrá iniciar sesión. Puede recuperarlo con «Mostrar eliminados»."
                                            title="Eliminar a @u.Nombre"
                                            aria-label="Eliminar a @u.Nombre">&#10005;</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
            @if (Model.Resultado.Total == 0)
            {
                <tr><td colspan="5" class="res-meta" style="text-align:center;padding:1.5rem">Sin resultados.</td></tr>
            }
        </tbody>
    </table>

    <partial name="_Paginacion" model="new PaginacionVm(Model.Resultado.Page, Model.Resultado.TotalPages, Model.Resultado.Total, Model.Resultado.Desde, Model.Resultado.Hasta)" />
</div>
