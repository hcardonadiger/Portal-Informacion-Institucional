@page
@model Diger.TramitesEstado.Web.Pages.Calendario.IndexModel
@{
    ViewData["Title"] = "Calendario";
    var meses = new[] { "", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
    var dias = new[] { "Dom", "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb" };
    var cultEs = System.Globalization.CultureInfo.GetCultureInfo("es");

    var vista = Model.Vista;
    var desde = Model.Desde;
    var ultimo = Model.Hasta.AddDays(-1);          // último día incluido
    var totalReuniones = Model.Data.Reuniones.Count;
    var porTipo = Model.Data.Actividad.GroupBy(e => e.Tipo).ToDictionary(g => g.Key, g => g.Count());

    // Al cambiar de granularidad se conserva el día si el rango actual lo contiene;
    // si no, se ancla al inicio del rango. Pasar de "mes" a "día" estando en el mes
    // corriente debe llevar a hoy, no al día 1.
    var ancla = Model.Hoy >= Model.Desde && Model.Hoy < Model.Hasta ? Model.Hoy : desde;
    var anclaIso = ancla.ToString("yyyy-MM-dd");

    // Solo la inicial. Con text-transform:capitalize el CSS también subía la
    // preposición: "Jueves 30 De Julio".
    string Cap(string s) => s.Length == 0 ? s : char.ToUpper(s[0], cultEs) + s[1..];
    string DiaLargo(DateOnly f) => Cap(f.ToString("dddd dd 'de' MMMM", cultEs));

    var alcance = vista switch
    {
        VistaCalendario.Dia    => "del día",
        VistaCalendario.Semana => "de la semana",
        _                      => "del mes",
    };
}

<div class="container" style="max-width:1280px">
    <partial name="_SuccessBanner" />

    <div class="cal-toolbar">
        <div class="cal-nav">
            @{
                var pasoLbl = vista switch
                {
                    VistaCalendario.Dia    => "Día",
                    VistaCalendario.Semana => "Semana",
                    _                      => "Mes",
                };
            }
            <div class="cal-seg">
                <a asp-page="/Calendario/Index" asp-route-vista="@vista" asp-route-fecha="@Model.Anterior.ToString("yyyy-MM-dd")"
                   title="@pasoLbl anterior" aria-label="@pasoLbl anterior"><svg class="ico"><use href="#i-chevron-izq"></use></svg></a>
                <a asp-page="/Calendario/Index" asp-route-vista="@vista" asp-route-fecha="@Model.Siguiente.ToString("yyyy-MM-dd")"
                   title="@pasoLbl siguiente" aria-label="@pasoLbl siguiente"><svg class="ico"><use href="#i-chevron"></use></svg></a>
            </div>
            <a class="cal-hoy" asp-page="/Calendario/Index" asp-route-vista="@vista">Hoy</a>
            <h2 class="cal-title">
                @switch (vista)
                {
                    case VistaCalendario.Dia:
                        @DiaLargo(desde) <text> </text><span>@desde.Year</span>
                        break;
                    case VistaCalendario.Semana when desde.Month == ultimo.Month:
                        @($"{desde.Day} – {ultimo.Day} de {meses[desde.Month].ToLowerInvariant()}") <text> </text><span>@desde.Year</span>
                        break;
                    case VistaCalendario.Semana:
                        @($"{desde.Day} {meses[desde.Month][..3].ToLowerInvariant()} – {ultimo.Day} {meses[ultimo.Month][..3].ToLowerInvariant()}") <text> </text><span>@ultimo.Year</span>
                        break;
                    default:
                        @meses[desde.Month] <text> </text><span>@desde.Year</span>
                        break;
                }
            </h2>
        </div>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
            <div class="cal-vistas">
                @foreach (var v in Enum.GetValues<VistaCalendario>())
                {
                    <a class="cal-vista @(v == vista ? "on" : "")" asp-page="/Calendario/Index"
                       asp-route-vista="@v" asp-route-fecha="@anclaIso">@(v == VistaCalendario.Dia ? "Día" : v.ToString())</a>
                }
            </div>
            <div class="cal-counts">
                <span><b>@totalReuniones</b> @(totalReuniones == 1 ? "reunión" : "reuniones")</span>
                <span><b>@Model.Data.Actividad.Count</b> @(Model.Data.Actividad.Count == 1 ? "actividad" : "actividades")</span>
            </div>
            @if (Model.PuedeGestionar)
            {
                <a class="btnp" asp-page="/Reuniones/Editor" asp-route-fecha="@anclaIso"><svg class="ico"><use href="#i-mas"></use></svg> Nueva reunión</a>
            }
        </div>
    </div>

    <div class="cal-layout">
        <div class="cal-cal">
            @if (vista == VistaCalendario.Dia)
            {
                @* ── Agenda del día ──────────────────────────────────── *@
                var reusDia = Model.ReunionesPorDia[desde].ToList();
                var actsDia = Model.ActividadPorDia[desde].ToList();
                <div class="cal-dia">
                    <div class="cal-dia-hdr @(desde == Model.Hoy ? "es-hoy" : "")">
                        <span class="cal-dia-num">@desde.Day</span>
                        <span class="cal-dia-tx">
                            <span class="cal-dia-t1">@DiaLargo(desde)</span>
                            <span class="cal-dia-t2">
                                @(reusDia.Count == 1 ? "1 reunión" : $"{reusDia.Count} reuniones")
                                · @(actsDia.Count == 1 ? "1 acción registrada" : $"{actsDia.Count} acciones registradas")
                            </span>
                        </span>
                        @if (Model.PuedeGestionar)
                        {
                            <a class="btns btns-sm" asp-page="/Reuniones/Editor" asp-route-fecha="@desde.ToString("yyyy-MM-dd")">
                                <svg class="ico"><use href="#i-mas"></use></svg> Agendar
                            </a>
                        }
                    </div>
                    <div class="cal-dia-lista">
                        @if (!reusDia.Any())
                        {
                            <div class="empty-state">
                                <div class="empty-state-ico"><svg class="ico"><use href="#i-calendario"></use></svg></div>
                                <div class="empty-state-t1">Sin reuniones este día</div>
                                <div class="empty-state-t2">Las acciones del portal siguen listadas a la derecha</div>
                            </div>
                        }
                        else
                        {
                            foreach (var r in reusDia)
                            {
                                var destino = Model.PuedeGestionar ? "/Reuniones/Editor" : "/Reuniones/Acta";
                                var meta = string.Join(" · ", new[] { r.Institucion, r.Tipo, r.Privada ? "Privada" : null }
                                    .Where(x => !string.IsNullOrWhiteSpace(x)));
                                <a class="cal-dia-item @(r.Privada ? "priv" : "")" data-tipo="Reunion"
                                   asp-page="@destino" asp-route-id="@r.Id">
                                    <span class="cal-dia-hora">@(string.IsNullOrWhiteSpace(r.Hora) ? "—" : r.Hora)</span>
                                    <span class="cal-dia-body">
                                        <span class="cal-dia-titulo">@r.Titulo</span>
                                        @if (meta.Length > 0)
                                        {
                                            <span class="cal-dia-meta">@meta</span>
                                        }
                                    </span>
                                </a>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                @* ── Grilla de 7 columnas: una fila en semana, las que haga falta en mes ── *@
                DateOnly inicioGrid;
                int celdas;
                int tope;      // cuántas reuniones se listan antes del "+N más"
                if (vista == VistaCalendario.Semana)
                {
                    inicioGrid = desde;
                    celdas = 7;
                    tope = 8;  // la fila ocupa todo el alto: caben muchas más
                }
                else
                {
                    inicioGrid = desde.AddDays(-(int)desde.DayOfWeek);
                    // Solo las semanas que el mes necesita: con 42 celdas fijas,
                    // meses como julio 2026 (34 celdas) arrastraban una fila vacía.
                    var diasDelMes = DateTime.DaysInMonth(desde.Year, desde.Month);
                    celdas = (int)Math.Ceiling(((int)desde.DayOfWeek + diasDelMes) / 7.0) * 7;
                    tope = 3;
                }

                <div class="cal-grid cal-head">
                    @foreach (var d in dias) { <div class="cal-dow">@d</div> }
                </div>
                <div class="cal-grid cal-body" id="cal-body">
                    @for (var i = 0; i < celdas; i++)
                    {
                        var dia = inicioGrid.AddDays(i);
                        var enRango = dia >= Model.Desde && dia < Model.Hasta;
                        var esHoy = dia == Model.Hoy;
                        var iso = dia.ToString("yyyy-MM-dd");
                        var reus = Model.ReunionesPorDia[dia].ToList();
                        var acts = Model.ActividadPorDia[dia].ToList();
                        @* Solo los días del rango son seleccionables: la consulta no trae
                           actividad de los días de relleno, así que nunca tendrían qué mostrar. *@
                        <div class="cal-cell@(enRango ? "" : " cal-out")@(esHoy ? " cal-today" : "")" data-fecha="@(enRango ? iso : null)">
                            <div class="cal-cell-top">
                                <span class="cal-num">@dia.Day</span>
                                @if (Model.PuedeGestionar && enRango)
                                {
                                    <a class="cal-add" title="Nueva reunión este día" aria-label="Nueva reunión este día"
                                       asp-page="/Reuniones/Editor" asp-route-fecha="@iso"><svg class="ico"><use href="#i-mas"></use></svg></a>
                                }
                            </div>
                            @foreach (var r in reus.Take(tope))
                            {
                                var destino = Model.PuedeGestionar ? "/Reuniones/Editor" : "/Reuniones/Acta";
                                <a class="cal-chip@(r.Privada ? " priv" : "")" data-tipo="Reunion" asp-page="@destino" asp-route-id="@r.Id"
                                   title="@(r.Privada ? "Privada · " : "")@(string.IsNullOrWhiteSpace(r.Hora) ? "" : r.Hora + " · ")@r.Titulo@(string.IsNullOrWhiteSpace(r.Institucion) ? "" : " — " + r.Institucion)">
                                    @if (!string.IsNullOrWhiteSpace(r.Hora)) { <time>@r.Hora</time> }
                                    @r.Titulo
                                </a>
                            }
                            @if (reus.Count > tope)
                            {
                                <button type="button" class="cal-mas" data-tipo="Reunion">+@(reus.Count - tope) más</button>
                            }
                            @if (acts.Any())
                            {
                                var resumen = string.Join(", ", acts.GroupBy(a => a.Tipo)
                                    .Select(g => $"{g.Count()} {CalendarioUi.Evento(g.Key).Etiqueta.ToLowerInvariant()}"));
                                <div class="cal-act" title="@acts.Count acción(es): @resumen">
                                    <span class="cal-act-bar">
                                        @* flex-grow entero en vez de width en %: evita el separador decimal
                                           de la cultura y renormaliza solo al filtrar un tipo. *@
                                        @foreach (var g in acts.GroupBy(a => a.Tipo).OrderBy(g => g.Key))
                                        {
                                            <i data-tipo="@g.Key" data-n="@g.Count()" style="flex:@g.Count();background:@CalendarioUi.Evento(g.Key).Color"></i>
                                        }
                                    </span>
                                    <span class="cal-act-n">@acts.Count</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <div class="cal-legend">
                <span class="cal-legend-lbl">Mostrar</span>
                @foreach (var t in Enum.GetValues<TipoEventoCalendario>())
                {
                    var ui = CalendarioUi.Evento(t);
                    <button type="button" class="cal-filtro on" data-filtro="@t" onclick="toggleFiltro(this)">
                        <span class="cal-dot" style="background:@ui.Color"></span>
                        @ui.Etiqueta
                        <span class="cal-filtro-n">@porTipo.GetValueOrDefault(t)</span>
                    </button>
                }
            </div>
        </div>

        @* ── Feed de actividad ───────────────────────────────────── *@
        <div class="cal-feed">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:1rem">
                <h3 style="margin:0" id="feed-title" data-defecto="Actividad @alcance">Actividad @alcance</h3>
                <button type="button" class="btns btns-sm" id="btn-ver-todo" style="display:none" onclick="verTodoElRango()">Ver todo</button>
            </div>
            @if (!Model.Data.Actividad.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-ico"><svg class="ico"><use href="#i-calendario"></use></svg></div>
                    <div class="empty-state-t1">Sin acciones registradas</div>
                    <div class="empty-state-t2">Las reuniones, tickets y expedientes del período aparecerán aquí</div>
                </div>
            }
            else
            {
                DateOnly? ultimoDia = null;
                foreach (var e in Model.Data.Actividad)
                {
                    if (ultimoDia != e.Fecha)
                    {
                        ultimoDia = e.Fecha;
                        <div class="cal-feed-day" data-fecha="@e.Fecha.ToString("yyyy-MM-dd")">@DiaLargo(e.Fecha)</div>
                    }
                    var ui = CalendarioUi.Evento(e.Tipo);
                    <a class="cal-ev" data-tipo="@e.Tipo" data-fecha="@e.Fecha.ToString("yyyy-MM-dd")" asp-page="@e.Pagina" asp-route-id="@e.RefId">
                        <span class="cal-ev-ico" style="background:@ui.Fondo;color:@ui.Texto"><svg class="ico"><use href="#@ui.IconoId"></use></svg></span>
                        <span class="cal-ev-body">
                            <span class="cal-ev-top">
                                <b>@ui.Etiqueta</b>
                                @if (!string.IsNullOrWhiteSpace(e.Etiqueta)) { <span class="cal-ev-tag">@e.Etiqueta</span> }
                                <span class="cal-ev-time">@e.Cuando.ToString("HH:mm")</span>
                            </span>
                            <span class="cal-ev-titulo">@e.Titulo</span>
                            @if (!string.IsNullOrWhiteSpace(e.Detalle))
                            {
                                <span class="cal-ev-det">@(e.Detalle!.Length > 90 ? e.Detalle[..90] + "…" : e.Detalle)</span>
                            }
                        </span>
                    </a>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
  var CAL_KEY = 'cal.filtros.ocultos';
  function ocultos(){ try { return new Set(JSON.parse(localStorage.getItem(CAL_KEY) || '[]')); } catch (e) { return new Set(); } }

  var diaSeleccionado = null;
  var tituloFeed = document.getElementById('feed-title');
  var btnVerTodo = document.getElementById('btn-ver-todo');

  var grilla = document.getElementById('cal-body');
  if (grilla) {
    grilla.addEventListener('click', function(ev){
      if (ev.target.closest('a')) return;
      var celda = ev.target.closest('.cal-cell');
      if (celda && celda.dataset.fecha) seleccionarDia(celda.dataset.fecha);
    });
  }

  function seleccionarDia(fecha) {
    diaSeleccionado = (diaSeleccionado === fecha) ? null : fecha;
    document.querySelectorAll('.cal-cell').forEach(function(c) {
      c.classList.toggle('cal-sel', c.dataset.fecha === diaSeleccionado);
    });
    if (diaSeleccionado) {
      var d = new Date(fecha + 'T12:00:00');
      var opciones = { weekday: 'long', day: 'numeric', month: 'long' };
      tituloFeed.textContent = 'Actividad del ' + d.toLocaleDateString('es-ES', opciones);
      btnVerTodo.style.display = '';
    } else {
      tituloFeed.textContent = tituloFeed.dataset.defecto;
      btnVerTodo.style.display = 'none';
    }
    aplicarFiltros();
  }

  function verTodoElRango() {
    diaSeleccionado = null;
    document.querySelectorAll('.cal-cell').forEach(function(c) { c.classList.remove('cal-sel'); });
    tituloFeed.textContent = tituloFeed.dataset.defecto;
    btnVerTodo.style.display = 'none';
    aplicarFiltros();
  }

  function aplicarFiltros(){
    var off = ocultos();
    document.querySelectorAll('[data-tipo]').forEach(function(el){
      var esDelDia = !diaSeleccionado || el.getAttribute('data-fecha') === diaSeleccionado;
      if (!el.hasAttribute('data-fecha')) esDelDia = true;
      el.style.display = (off.has(el.getAttribute('data-tipo')) || !esDelDia) ? 'none' : '';
    });
    document.querySelectorAll('.cal-filtro').forEach(function(b){
      var on = !off.has(b.getAttribute('data-filtro'));
      b.classList.toggle('on', on); b.classList.toggle('off', !on);
    });
    document.querySelectorAll('.cal-act').forEach(function(barra){
      var n = 0;
      barra.querySelectorAll('.cal-act-bar > i').forEach(function(seg){
        if (seg.style.display !== 'none') n += parseInt(seg.dataset.n, 10) || 0;
      });
      barra.querySelector('.cal-act-n').textContent = n;
      barra.style.display = n ? '' : 'none';
    });
    document.querySelectorAll('.cal-feed-day').forEach(function(h){
      if (diaSeleccionado && h.getAttribute('data-fecha') !== diaSeleccionado) {
          h.style.display = 'none';
          return;
      }
      var visible = false, n = h.nextElementSibling;
      while (n && n.classList.contains('cal-ev')) {
        if (n.style.display !== 'none') { visible = true; break; }
        n = n.nextElementSibling;
      }
      h.style.display = visible ? '' : 'none';
    });
  }

  function toggleFiltro(btn){
    var t = btn.getAttribute('data-filtro');
    var off = ocultos();
    if (off.has(t)) off.delete(t); else off.add(t);
    localStorage.setItem(CAL_KEY, JSON.stringify(Array.from(off)));
    aplicarFiltros();
  }

  aplicarFiltros();

  /* ── Navegación AJAX del calendario ──────────────────────────────── */
  var MESES = ['','Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
  var DIAS = ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'];
  var calState = {
    vista: '@vista',
    fecha: '@desde.ToString("yyyy-MM-dd")',
    puedeGestionar: @(Model.PuedeGestionar ? "true" : "false"),
    tiposUi: null,
    loading: false
  };

  function parseDate(s){ var p=s.split('-'); return new Date(+p[0], +p[1]-1, +p[2], 12, 0, 0); }
  function isoDate(d){ return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
  function hoy(){ return isoDate(new Date()); }

  function escH(s){ var d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }

  function diaLargo(iso){
    var d = parseDate(iso);
    return d.toLocaleDateString('es-HN', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
  }

  function calcNav(vista, fechaIso){
    var d = parseDate(fechaIso);
    var ant, sig;
    if(vista==='Dia'){ ant=new Date(d); ant.setDate(d.getDate()-1); sig=new Date(d); sig.setDate(d.getDate()+1); }
    else if(vista==='Semana'){ ant=new Date(d); ant.setDate(d.getDate()-7); sig=new Date(d); sig.setDate(d.getDate()+7); }
    else { ant=new Date(d.getFullYear(), d.getMonth()-1, 1, 12); sig=new Date(d.getFullYear(), d.getMonth()+1, 1, 12); }
    return { anterior: isoDate(ant), siguiente: isoDate(sig) };
  }

  function calTitulo(vista, desdeIso, hastaIso){
    var d = parseDate(desdeIso);
    if(vista==='Dia') return diaLargo(desdeIso);
    if(vista==='Semana'){
      var h = parseDate(hastaIso); h.setDate(h.getDate()-1);
      if(d.getMonth()===h.getMonth()) return d.getDate()+' – '+h.getDate()+' de '+MESES[d.getMonth()+1].toLowerCase()+' <span>'+d.getFullYear()+'</span>';
      return d.getDate()+' '+MESES[d.getMonth()+1].substring(0,3).toLowerCase()+' – '+h.getDate()+' '+MESES[h.getMonth()+1].substring(0,3).toLowerCase()+' <span>'+h.getFullYear()+'</span>';
    }
    return MESES[d.getMonth()+1]+' <span>'+d.getFullYear()+'</span>';
  }

  async function calNavegar(vista, fecha){
    if(calState.loading) return;
    calState.loading = true;
    calState.vista = vista;
    calState.fecha = fecha;
    diaSeleccionado = null;

    if(window._dgProgress) window._dgProgress.start();
    try {
      var resp = await fetch('/Calendario?handler=Data&vista='+vista+'&fecha='+fecha);
      var data = await resp.json();
      if(data.tiposUi) calState.tiposUi = data.tiposUi;
      renderCalendario(data, vista);
      var nav = calcNav(vista, data.desde);
      actualizarToolbar(vista, data.desde, data.hasta, nav, data);
      history.replaceState(null, '', '/Calendario?vista='+vista+'&fecha='+fecha);
    } catch(e){ console.error('Error cargando calendario:', e); }
    calState.loading = false;
    if(window._dgProgress) window._dgProgress.done();
  }

  function actualizarToolbar(vista, desde, hasta, nav, data){
    var titulo = document.querySelector('.cal-title');
    if(titulo) titulo.innerHTML = calTitulo(vista, desde, hasta);

    document.querySelectorAll('.cal-seg a').forEach(function(a, i){
      a.href = '#';
      a.onclick = function(e){ e.preventDefault(); calNavegar(vista, i===0? nav.anterior : nav.siguiente); };
    });

    var hoyBtn = document.querySelector('.cal-hoy');
    if(hoyBtn){ hoyBtn.href='#'; hoyBtn.onclick=function(e){ e.preventDefault(); calNavegar(vista, hoy()); }; }

    document.querySelectorAll('.cal-vista').forEach(function(a){
      var v = a.textContent.trim();
      if(v==='Día') v='Dia'; else if(v==='Semana') v='Semana'; else v='Mes';
      a.classList.toggle('on', v===vista);
      a.href='#';
      a.onclick=function(e){ e.preventDefault(); calNavegar(v, desde); };
    });

    var counts = document.querySelector('.cal-counts');
    if(counts){
      var nr = data.reuniones.length;
      var na = data.actividad.length;
      counts.innerHTML = '<span><b>'+nr+'</b> '+(nr===1?'reunión':'reuniones')+'</span><span><b>'+na+'</b> '+(na===1?'actividad':'actividades')+'</span>';
    }

    var nuevoBtn = document.querySelector('.cal-toolbar .btnp');
    if(nuevoBtn) nuevoBtn.href = '/Reuniones/Editor?fecha='+desde;
  }

  function tipoUi(tipoStr){
    if(!calState.tiposUi) return {etiqueta:tipoStr, color:'#888', fondo:'#f1f1f1', texto:'#444', iconoId:'i-calendario'};
    var found = calState.tiposUi.find(function(t){ return t.tipo===tipoStr; });
    return found || {etiqueta:tipoStr, color:'#888', fondo:'#f1f1f1', texto:'#444', iconoId:'i-calendario'};
  }

  function renderCalendario(data, vista){
    var calCal = document.querySelector('.cal-cal');
    if(!calCal) return;
    var hoyIso = hoy();

    var reusPorDia = {};
    data.reuniones.forEach(function(r){ if(!reusPorDia[r.fecha]) reusPorDia[r.fecha]=[]; reusPorDia[r.fecha].push(r); });
    var actsPorDia = {};
    data.actividad.forEach(function(e){ if(!actsPorDia[e.fecha]) actsPorDia[e.fecha]=[]; actsPorDia[e.fecha].push(e); });

    var html = '';
    if(vista==='Dia'){
      var reus = reusPorDia[data.desde] || [];
      var acts = actsPorDia[data.desde] || [];
      html += '<div class="cal-dia">';
      html += '<div class="cal-dia-hdr'+(data.desde===hoyIso?' es-hoy':'')+'"><span class="cal-dia-num">'+parseDate(data.desde).getDate()+'</span>';
      html += '<span class="cal-dia-tx"><span class="cal-dia-t1">'+escH(diaLargo(data.desde))+'</span>';
      html += '<span class="cal-dia-t2">'+(reus.length===1?'1 reunión':reus.length+' reuniones')+' · '+(acts.length===1?'1 acción registrada':acts.length+' acciones registradas')+'</span></span>';
      if(calState.puedeGestionar) html += '<a class="btns btns-sm" href="/Reuniones/Editor?fecha='+data.desde+'"><svg class="ico"><use href="#i-mas"></use></svg> Agendar</a>';
      html += '</div><div class="cal-dia-lista">';
      if(!reus.length){
        html += '<div class="empty-state"><div class="empty-state-ico"><svg class="ico"><use href="#i-calendario"></use></svg></div><div class="empty-state-t1">Sin reuniones este día</div><div class="empty-state-t2">Las acciones del portal siguen listadas a la derecha</div></div>';
      } else {
        reus.forEach(function(r){
          var destino = calState.puedeGestionar ? '/Reuniones/Editor/' : '/Reuniones/Acta/';
          var meta = [r.institucion, r.tipo, r.privada?'Privada':null].filter(Boolean).join(' · ');
          html += '<a class="cal-dia-item'+(r.privada?' priv':'')+'" data-tipo="Reunion" href="'+destino+r.id+'">';
          html += '<span class="cal-dia-hora">'+(r.hora||'—')+'</span><span class="cal-dia-body"><span class="cal-dia-titulo">'+escH(r.titulo)+'</span>';
          if(meta) html += '<span class="cal-dia-meta">'+escH(meta)+'</span>';
          html += '</span></a>';
        });
      }
      html += '</div></div>';
    } else {
      var desdeD = parseDate(data.desde);
      var tope = vista==='Semana' ? 8 : 3;
      var inicioGrid, celdas;
      if(vista==='Semana'){ inicioGrid=new Date(desdeD); celdas=7; }
      else {
        inicioGrid = new Date(desdeD);
        inicioGrid.setDate(1);
        inicioGrid.setDate(inicioGrid.getDate() - inicioGrid.getDay());
        var diasMes = new Date(desdeD.getFullYear(), desdeD.getMonth()+1, 0).getDate();
        var offset = new Date(desdeD.getFullYear(), desdeD.getMonth(), 1).getDay();
        celdas = Math.ceil((offset + diasMes) / 7) * 7;
      }

      html += '<div class="cal-grid cal-head">';
      DIAS.forEach(function(d){ html += '<div class="cal-dow">'+d+'</div>'; });
      html += '</div><div class="cal-grid cal-body" id="cal-body">';

      for(var i=0; i<celdas; i++){
        var dia = new Date(inicioGrid);
        dia.setDate(inicioGrid.getDate() + i);
        var iso = isoDate(dia);
        var enRango = iso >= data.desde && iso < data.hasta;
        var esHoy = iso === hoyIso;
        var reus = reusPorDia[iso] || [];
        var acts = actsPorDia[iso] || [];

        html += '<div class="cal-cell'+(enRango?'':' cal-out')+(esHoy?' cal-today':'')+'" data-fecha="'+(enRango?iso:'')+'">';
        html += '<div class="cal-cell-top"><span class="cal-num">'+dia.getDate()+'</span>';
        if(calState.puedeGestionar && enRango) html += '<a class="cal-add" title="Nueva reunión" href="/Reuniones/Editor?fecha='+iso+'"><svg class="ico"><use href="#i-mas"></use></svg></a>';
        html += '</div>';

        reus.slice(0, tope).forEach(function(r){
          var destino = calState.puedeGestionar ? '/Reuniones/Editor/' : '/Reuniones/Acta/';
          html += '<a class="cal-chip'+(r.privada?' priv':'')+'" data-tipo="Reunion" href="'+destino+r.id+'" title="'+escH((r.privada?'Privada · ':'')+(r.hora?r.hora+' · ':'')+r.titulo)+'">';
          if(r.hora) html += '<time>'+escH(r.hora)+'</time>';
          html += escH(r.titulo)+'</a>';
        });
        if(reus.length > tope) html += '<button type="button" class="cal-mas" data-tipo="Reunion">+'+(reus.length-tope)+' más</button>';

        if(acts.length){
          var grupos = {};
          acts.forEach(function(a){ if(!grupos[a.tipo]) grupos[a.tipo]={n:0,ui:tipoUi(a.tipo)}; grupos[a.tipo].n++; });
          var totalActs = acts.length;
          html += '<div class="cal-act" title="'+totalActs+' acción(es)"><span class="cal-act-bar">';
          Object.keys(grupos).sort().forEach(function(t){ html += '<i data-tipo="'+t+'" data-n="'+grupos[t].n+'" style="flex:'+grupos[t].n+';background:'+grupos[t].ui.color+'"></i>'; });
          html += '</span><span class="cal-act-n">'+totalActs+'</span></div>';
        }
        html += '</div>';
      }
      html += '</div>';
    }

    // Leyenda
    var tipos = calState.tiposUi || [];
    var porTipo = {};
    data.actividad.forEach(function(e){ porTipo[e.tipo] = (porTipo[e.tipo]||0)+1; });
    data.reuniones.forEach(function(){ porTipo['Reunion'] = (porTipo['Reunion']||0)+1; });
    html += '<div class="cal-legend"><span class="cal-legend-lbl">Mostrar</span>';
    tipos.forEach(function(t){
      html += '<button type="button" class="cal-filtro on" data-filtro="'+t.tipo+'" onclick="toggleFiltro(this)"><span class="cal-dot" style="background:'+t.color+'"></span>'+escH(t.etiqueta)+'<span class="cal-filtro-n">'+(porTipo[t.tipo]||0)+'</span></button>';
    });
    html += '</div>';

    calCal.innerHTML = html;

    // Feed de actividad
    var feed = document.querySelector('.cal-feed');
    if(feed){
      var alcance = vista==='Dia'?'del día':vista==='Semana'?'de la semana':'del mes';
      var feedHtml = '<div style="display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:1rem"><h3 style="margin:0" id="feed-title" data-defecto="Actividad '+alcance+'">Actividad '+alcance+'</h3><button type="button" class="btns btns-sm" id="btn-ver-todo" style="display:none" onclick="verTodoElRango()">Ver todo</button></div>';
      if(!data.actividad.length){
        feedHtml += '<div class="empty-state"><div class="empty-state-ico"><svg class="ico"><use href="#i-calendario"></use></svg></div><div class="empty-state-t1">Sin acciones registradas</div><div class="empty-state-t2">Las reuniones, tickets y expedientes del período aparecerán aquí</div></div>';
      } else {
        var lastDay = null;
        data.actividad.forEach(function(e){
          if(lastDay !== e.fecha){
            lastDay = e.fecha;
            feedHtml += '<div class="cal-feed-day" data-fecha="'+e.fecha+'">'+escH(diaLargo(e.fecha))+'</div>';
          }
          var ui = tipoUi(e.tipo);
          var detalle = e.detalle && e.detalle.length > 90 ? e.detalle.substring(0,90)+'…' : e.detalle;
          var hora = e.cuando ? e.cuando.split('T')[1] : '';
          feedHtml += '<a class="cal-ev" data-tipo="'+e.tipo+'" data-fecha="'+e.fecha+'" href="'+e.pagina+'/'+e.refId+'">';
          feedHtml += '<span class="cal-ev-ico" style="background:'+ui.fondo+';color:'+ui.texto+'"><svg class="ico"><use href="#'+ui.iconoId+'"></use></svg></span>';
          feedHtml += '<span class="cal-ev-body"><span class="cal-ev-top"><b>'+escH(ui.etiqueta)+'</b>';
          if(e.etiqueta) feedHtml += '<span class="cal-ev-tag">'+escH(e.etiqueta)+'</span>';
          feedHtml += '<span class="cal-ev-time">'+hora+'</span></span>';
          feedHtml += '<span class="cal-ev-titulo">'+escH(e.titulo)+'</span>';
          if(detalle) feedHtml += '<span class="cal-ev-det">'+escH(detalle)+'</span>';
          feedHtml += '</span></a>';
        });
      }
      feed.innerHTML = feedHtml;
    }

    tituloFeed = document.getElementById('feed-title');
    btnVerTodo = document.getElementById('btn-ver-todo');

    // Re-bind grid click
    grilla = document.getElementById('cal-body');
    if(grilla){
      grilla.addEventListener('click', function(ev){
        if(ev.target.closest('a')) return;
        var celda = ev.target.closest('.cal-cell');
        if(celda && celda.dataset.fecha) seleccionarDia(celda.dataset.fecha);
      });
    }

    aplicarFiltros();
  }

  /* Interceptar links de navegación del calendario */
  document.querySelector('.cal-toolbar').addEventListener('click', function(ev){
    var a = ev.target.closest('a.cal-vista, a.cal-hoy, .cal-seg a');
    if(!a) return;
    if(a.href && a.href !== '#' && !a.onclick){
      ev.preventDefault();
      var url = new URL(a.href, location.origin);
      var v = url.searchParams.get('vista') || calState.vista;
      var f = url.searchParams.get('fecha') || calState.fecha;
      calNavegar(v, f);
    }
  });

  /* Inicializar tiposUi desde el servidor (primer render) */
  (function(){
    calState.tiposUi = [
      @foreach (var t in Enum.GetValues<TipoEventoCalendario>())
      {
        var ui = CalendarioUi.Evento(t);
        <text>{tipo:'@t',etiqueta:'@ui.Etiqueta',color:'@ui.Color',fondo:'@ui.Fondo',texto:'@ui.Texto',iconoId:'@ui.IconoId'},</text>
      }
    ];
  })();
</script>
}
