@model Diger.TramitesEstado.Web.Pages.Chat.IndexModel
@*
  La cola compartida: la misma tabla para toda la bandeja. Cualquiera toma; jefaturas, PMO y
  Global además reparten con «Asignar a…». La página la vuelve a pedir (handler Cola) cada vez
  que el hub avisa ColaActualizada, así que no debe depender de nada fuera de este bloque.
*@
@if (Model.Cola.Count > 0)
{
  <div class="sidebar-section">
    <div class="sidebar-section-title">En cola</div>
    @foreach (var s in Model.Cola)
    {
      <div class="chat-item cola" id="ci-@s.Id">
        <div class="ci-avatar">👤</div>
        <div class="ci-info">
          <div class="ci-nombre">@s.UsuarioNombre</div>
          <div class="ci-tema">@(s.TemaNombre ?? "Sin tema")</div>
          <div class="ci-hora">@s.Inicio.ToLocalTime().ToString("HH:mm") · Sin asignar</div>
        </div>
        <form method="post" asp-page="/Chat/Index" asp-page-handler="Tomar" style="margin:0">
          <input type="hidden" name="sesionId" value="@s.Id" />
          <button type="submit" class="btn-tomar">Tomar</button>
        </form>
      </div>
      @if (Model.PuedeAsignar)
      {
        var candidatos = Model.AsignablesDe(s);
        var delTema    = candidatos.Where(t => t.DelTema).ToList();
        var otros      = candidatos.Where(t => !t.DelTema).ToList();
        <form method="post" asp-page="/Chat/Index" asp-page-handler="Asignar" class="cola-asignar" data-asignar="@s.Id">
          <input type="hidden" name="sesionId" value="@s.Id" />
          <select name="tecnicoId" required aria-label="Asignar el chat de @s.UsuarioNombre a">
            <option value="">Asignar a…</option>
            @if (delTema.Count > 0)
            {
              <optgroup label="Del tema @s.TemaNombre">
                @foreach (var t in delTema) { <option value="@t.Id">@t.Nombre</option> }
              </optgroup>
            }
            <optgroup label="@(delTema.Count > 0 ? "Otros técnicos" : "Técnicos")">
              @foreach (var t in otros) { <option value="@t.Id">@t.Nombre</option> }
            </optgroup>
          </select>
          <button type="submit" class="btn-asignar">Asignar</button>
        </form>
      }
    }
  </div>
}
