<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Diger.TramitesEstado.Infrastructure</RootNamespace>
    <AssemblyName>Diger.TramitesEstado.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Tipografía del Manual de Marca DIGER (pág. 08), embarcada porque
       QuestPDF con licencia Community no descarga fuentes. Poppins se
       distribuye bajo SIL Open Font License, que permite la redistribución;
       la licencia viaja en Reports/Fuentes/OFL.txt. -->
  <ItemGroup>
    <EmbeddedResource Include="Reports\Fuentes\Poppins-Medium.ttf" />
    <EmbeddedResource Include="Reports\Fuentes\Poppins-ExtraBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Diger.TramitesEstado.Application.csproj" />
    <ProjectReference Include="..\Domain\Diger.TramitesEstado.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="QuestPDF" Version="2024.10.4" />
  </ItemGroup>

</Project>
